// console_panel.at — ConsolePanel 组件（PLAN-001 T-01 基座直迁）。
//
// 基座 Plan 449 形态：无 props，经 `use editor_store` 直读
// .store.console/.store.edits，自有 msg，handler 直调 store（vm 已验证
// 模式）。注：组件子树对 MCP 快照不可见——测试断言走 autoui_state。

use editor_store: EditorStore

style console_meta = "text-[11px] text-muted-foreground ml-auto"
widget ConsolePanel {
    msg { Clear }

    view {
        col (style: "w-full shrink-0") {
            col (style: "h-px w-full bg-border")
            row (style: "h-7 items-center bg-muted/30 shrink-0 gap-3 px-2") {
                text "CONSOLE" {
                    style: "text-[11px] font-bold text-muted-foreground"
                }
                button (text: "Clear", variant: "text") {
                    onclick: .Clear
                    style: "text-[11px] h-5 px-1 text-muted-foreground"
                }
                text "edits: ${.store.edits}" {
                    style: console_meta
                }
            }
            scroll (style: "h-40 w-full bg-muted/10 shrink-0") {
                col (style: "p-2") {
                    text .store.console {
                        style: "text-xs font-mono text-muted-foreground"
                    }
                }
            }
        }
    }

    on {
        .Clear -> { store.ConsoleClear() }
    }
}
