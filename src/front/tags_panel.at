// tags_panel.at — 标签面板壳（PLAN-008 T-02；BacklinksPanel/FindPanel
// 同构第三实例——013 组件纪律）。
//
// vm 组件边界（console_panel 同判：组件子树对 MCP 快照不可见——测试断言
// 走 autoui_state、点击锚留根视图）：本组件 = 面板壳（标题/收起）；tag
// 行/展开页行/空态在 App 根视图右栏渲染（013 树行/tab 条同款留根纪律）。
// 刷新为自动化（Init/Save 成功/面板开启/建页/删除/重命名——触发集 v4
// 同口多一 fetch，PLAN-008 触发集不扩），无手动刷新钮。

use editor_store: EditorStore

widget TagsPanel {
    msg { Toggle }

    view {
        row (style: "h-7 items-center bg-muted/30 shrink-0 gap-3 px-2 w-full") {
            text "TAGS" {
                style: "text-[11px] font-bold text-muted-foreground"
            }
            button (text: "收起", variant: "text") {
                onclick: .Toggle
                style: "text-[11px] h-5 px-1 text-muted-foreground"
            }
        }
    }

    on {
        .Toggle -> { store.TagsToggle() }
    }
}
