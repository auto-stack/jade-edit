// app.at — jade-edit 根组件（PLAN-001 T-01 换基：基座 chrome = auto-edit
// PLAN-003 交付形态；树行 = bps filetree 留根视图；编辑器 = autodown_editor）。
//
// 结构：
//   editor_store.at   store EditorStore —— tabs/脏标/保存流 + chrome 状态
//                     （状态权威；视图唯一读面 `.store.*`）
//   status_bar.at     StatusBar 组件（013 形态：读 .store + 直调 store）
//   console_panel.at  ConsolePanel 组件（同上）
//   app.at            widget App —— actions 声明（三源绑定：shortcut /
//                     menubar / MCP）+ 树行/tab 条/编辑区/弹层留根视图
//                     （vm 组件边界：MCP 快照定位锚不进组件子树）+ on 薄委托。
//
// vm 组件边界照执（auto-edit README「vm 组件边界」，Plan 449 结论）：
//   树行（文件打开 onclick 锚）、tab 条（x/「+」形状定位）、编辑区
//   （autodown_editor 绑定根事件）、确认弹层（文本定位）、空态文本——
//   全部留根视图。menubar/toolbar 为声明式组件族（PLAN-630：VM=Popover
//   lowering，Vue=shadcn）。
//
// 编辑器（autodown_editor，PLAN-081 T-03 实证形态沿用）：key = active_key
// ——key 变即重挂载读 content:（播种通道）；oninput: .Edit 单参全文回写
// （INPUT_TEXT 通道，041 同约定）；final: true = 文档恒终态。不调用任何
// autodown_* 内建（041④ 坏字节码红线）。

use editor_store: EditorStore
use status_bar: StatusBar
use console_panel: ConsolePanel
use backlinks_panel: BacklinksPanel
use find_panel: FindPanel
use tags_panel: TagsPanel
use bps.navigation.filetree.tree_util: flatten_tree, toggle_id
use bps.navigation.filetree.tree_icon: TreeIcon
use back.api: tree, ws_root, link_index, search_wiki, create_page, rename_page, delete_page, tags_index, linkify_page, page_meta, set_page_meta

style warn_label = "text-[12px] text-amber-400 mr-1"

// —— 链接面板派生（PLAN-003 T-03）。数据态在 App 模型（⚠ 不入 store：
// vm 轨 store 上下文 json.to_value 产物直落裸 vmref 损坏——T-03 三形态
// 实测，dump `link_pages: <vmref> (unknown)`、.len() 消费即零；App 上下
// 文 = Init ft_nodes 同款已证。vue 轨无此分野，单源两轨同走 App 态）。
// 入参 = link_index 标量契约原文（页面数组 [{path,title,links:
// [{target,anchor,exists,target_path}]}]）。遍历 while+索引（P614：
// for-in 参数列表零迭代）。
// ⚠ json.to_value 只能在 handler 体内直调（T-04 实勘：模块函数体内该
// 调用被 ts_adapter 静默发射为恒等 `out = j`——上游生成器缺口；handler
// 体 `x = json.to_value(y)` 正确发射 JSON.parse——Init tree 同款）。故
// 解析内联在各 fetch 触点（Init/ActBacklinks/ActSave/LinksRefresh），
// 本组函数只做已解析 List 的行派生。

/// 反链行集：全页面出链扫描，target_path 命中激活档 → {source_path}；
/// 自链接天然排除（source == active 跳过——SD-302：自链接计入出链不计
/// 入反链）。active = ""（untitled/无激活档）→ 恒空（卫语句——否则悬空
/// 出链 target_path:"" 会误配空路径，T-04 实勘）。
fn backlink_rows_of(pages List, active str) List {
    var out List = []
    if active == "" {
        return out
    }
    var i int = 0
    while i < pages.len() {
        var page = pages[i]
        var ppath str = page.path
        if ppath != active {
            var links List = page.links
            var k int = 0
            while k < links.len() {
                var lnk = links[k]
                var ltp str = lnk.target_path
                if ltp == active {
                    out.push({ source_path: ppath, anchor: "" })
                }
                k = k + 1
            }
        }
        i = i + 1
    }
    return out
}

/// 出链行集：激活档 links 原序 {target, exists, target_path}（悬空行
/// exists=false 由视图渲染为非点击文本）。
fn outlink_rows_of(pages List, active str) List {
    var out List = []
    var i int = 0
    while i < pages.len() {
        var page = pages[i]
        var ppath str = page.path
        if ppath == active {
            var links List = page.links
            var k int = 0
            while k < links.len() {
                var lnk = links[k]
                var t str = lnk.target
                var tp str = lnk.target_path
                var ex bool = lnk.exists
                out.push({ target: t, exists: ex, target_path: tp })
                k = k + 1
            }
        }
        i = i + 1
    }
    return out
}

/// 未链接提及行集（PLAN-009 T-02；SD-901 mentions 半）——search_wiki
/// 结果三则过滤 + 行装配 {path, snippet}：①path != active（自身——
/// 与 backlink_rows_of 同守卫语义）；②path ∉ linked 源集（已链源——
/// 反链段已示不重复；入参 = 现算 bl_rows）；③snippet != ""（title-only
/// 命中非提及语义——SD-401 snippet 空口径复用）。空 active → 恒空
/// （卫语句——同 backlink_rows_of）。**纯派生零 back 增量**：fetch 在
/// MentionsRefreshOf 共享口（守卫链 backlinks_open → 非 active 空——
/// 面板关零 POST，D-21 面纪律）。
fn mentions_of(results List, active str, linked List) List {
    var out List = []
    if active == "" {
        return out
    }
    var i int = 0
    while i < results.len() {
        // ⚠ D-20②：列表元素先拷局部变量再取字段。
        var r = results[i]
        var p str = r.path
        var snip str = r.snippet
        var keep bool = false
        if p != active {
            if snip != "" {
                keep = true
            }
        }
        if keep {
            var k int = 0
            while k < linked.len() {
                var l = linked[k]
                var sp str = l.source_path
                if sp == p {
                    keep = false
                }
                k = k + 1
            }
        }
        if keep {
            out.push({ path: p, snippet: snip })
        }
        i = i + 1
    }
    return out
}

// —— 查找面板派生（PLAN-004 T-02）。纯内存面（快开零 back 增量）；数据
// 态在 App 模型（D-20④ 同款裁定——链接态先例）。

/// 快开数据源：ft_nodes 全量 .ad 路径。栈式 while 展开（禁递归——C-4/
/// P614 家族纪律；flatten_tree 同族消费先例 bps tree_util）；兄弟倒序
/// 压栈保 fs.tree 遍历序（dirs-first + 名称 casefold——与 back
/// collect_ad_pages walk 序同源，快开/检索/链接三面覆盖一致）。
fn collect_ad_paths(nodes List) List {
    var out List = []
    var stack List = []
    var i int = nodes.len()
    while i > 0 {
        i = i - 1
        var n = nodes[i]
        stack.push(n)
    }
    var si int = 0
    while si < stack.len() {
        // ⚠ D-20②：列表元素先拷局部变量再取字段/调方法。
        var n = stack[si]
        si = si + 1
        var kind str = n.kind
        if kind == "file" {
            var nid str = n.id
            if nid.ends_with(".ad") {
                out.push(nid)
            }
        } else {
            var kids List = n.children
            var k int = kids.len()
            while k > 0 {
                k = k - 1
                var c = kids[k]
                stack.push(c)
            }
        }
    }
    return out
}

/// 快开过滤：双侧 to_lower contains（探针 A 定谳同裁——检索匹配同语义
/// SD-401）；空 q = 全量（Ctrl+P 首开即全档清单——VS Code 同形态）。
/// 行对象 = {path}（与检索行 path 键对齐——视图单渲染面）。
fn file_rows_of(paths List, q str) List {
    var out List = []
    var ql str = q.to_lower()
    var i int = 0
    while i < paths.len() {
        var p str = paths[i]
        var hit bool = false
        if ql == "" {
            hit = true
        } else {
            var pl str = p.to_lower()
            if pl.contains(ql) {
                hit = true
            }
        }
        if hit {
            out.push({ path: p })
        }
        i = i + 1
    }
    return out
}

/// 悬空建页路径预览（PLAN-005 T-02）——back wsys.title_to_path 的 front
/// 镜像纯函数（同一 while-contains 收敛惯用法 + dash-收敛空名探针）。
/// **仅弹层显示用**：权威在 back（create_page 落盘名），漂移=观感非
/// 正确性。规则 v1（SD-501）：九字符 `\/:*?"<>|` → `-`（首现/全量两态
/// 皆收敛——.replace 次数语义双轨未证）+ trim；空名守卫（trim 空或
/// 收敛后恰 "-"——`///` 形）→ ""；非空拼 ".ad"。
fn title_to_path(title str) str {
    var bad List = ["\\", "/", ":", "*", "?", "\"", "<", ">", "|"]
    var t str = title
    var i int = 0
    while i < bad.len() {
        // ⚠ D-20②：列表元素先拷局部变量再调方法。
        var c str = bad[i]
        while t.contains(c) {
            t = t.replace(c, "-")
        }
        i = i + 1
    }
    t = t.trim()
    if t == "" {
        return ""
    }
    var probe str = t
    while probe.contains("--") {
        probe = probe.replace("--", "-")
    }
    if probe == "-" {
        return ""
    }
    return t + ".ad"
}
/// 路径文件 stem（"wiki/Old.ad" → "Old"；根档 "Old.ad" → "Old"）——
/// split 法（D-20③ 同族纪律；wsys.stem_of 的 front 镜像——rename_q 预填
/// /影响面预览共用；文件名内嵌 ".ad" 病理形态不支持，与 back 同限）。
fn path_stem(path str) str {
    var segs = path.split("/")
    var fname str = segs[segs.len() - 1]
    if fname.ends_with(".ad") {
        var parts = fname.split(".ad")
        return parts[0]
    }
    return fname
}

/// 重命名影响面预览纯函数（PLAN-006 T-02）——link_pages 全页面出链扫
/// target == stem **精确相等**（G3 同口径；与 back rewrite_links 匹配语
/// 义一致）。返回「将改写 N 页 M 处链接」/「无入链」。**仅弹层显示用**
/// ：真实改写在 back 单事务（rename_page），此处计数 = 预览非权威；与
/// back 覆盖差（walk depth 4 同源 collect_ad_pages——一致）。
fn rename_impact_text(pages List, stem str) str {
    var n int = 0
    var m int = 0
    var i int = 0
    while i < pages.len() {
        // ⚠ D-20②：列表元素先拷局部变量再取字段。
        var page = pages[i]
        var links List = page.links
        var hit int = 0
        var k int = 0
        while k < links.len() {
            var lnk = links[k]
            var t str = lnk.target
            if t == stem {
                hit = hit + 1
            }
            k = k + 1
        }
        if hit > 0 {
            n = n + 1
            m = m + hit
        }
        i = i + 1
    }
    if n == 0 {
        return "无入链"
    }
    return "将改写 " + n.str() + " 页 " + m.str() + " 处链接"
}

/// 删除影响面预览纯函数（PLAN-007 T-03；SD-701 悬空化语义的弹层防
/// 线）——link_pages 全页面出链扫 target == stem **精确相等**（rename_
/// impact 同口径；入链 = 他档出链指向被删档 stem）。返回「N 处入链将
/// 变为悬空」/「无入链」。**仅弹层显示用**：删除本身在 back 单事务
///（delete_page）且**不改写源文**——此处计数 = 删除后果预告非权威。
fn dangling_impact(pages List, stem str) str {
    var m int = 0
    var i int = 0
    while i < pages.len() {
        // ⚠ D-20②：列表元素先拷局部变量再取字段。
        var page = pages[i]
        var links List = page.links
        var k int = 0
        while k < links.len() {
            var lnk = links[k]
            var t str = lnk.target
            if t == stem {
                m = m + 1
            }
            k = k + 1
        }
        i = i + 1
    }
    if m == 0 {
        return "无入链"
    }
    return m.str() + " 处入链将变为悬空"
}

/// tab 关闭面预览纯函数（PLAN-007 T-03）——tabs 全扫 path == 目标
///（tab 身份 = path——Open 已开即激活，同名档至多一 tab）。返回
///「M 个标签页将关闭，未保存修改将丢弃」/「无打开标签页」。未保存
/// 修改丢弃警示 = 关闭面语义（RemoveAt 直接弃——CloseTab 确认弹层
/// 不涉，删除场景档已消失无处可存）。
fn tabs_impact_text(tabs List, path str) str {
    var m int = 0
    var i int = 0
    while i < tabs.len() {
        // ⚠ D-20②：列表元素先拷局部变量再取字段。
        var t = tabs[i]
        var tp str = t.path
        if tp == path {
            m = m + 1
        }
        i = i + 1
    }
    if m == 0 {
        return "无打开标签页"
    }
    return m.str() + " 个标签页将关闭，未保存修改将丢弃"
}

/// 悬空目标聚合行纯函数（PLAN-008 T-03；wanted 模式数据面——rename_
/// impact/dangling_impact 纯函数族同构第三实例）：link_pages 全页面
/// 出链扫 exists=false → 按 target 聚合计数（行 = {target,count,label}
/// ——label 派生期拼接 `{target}（{n}）`，双段插值 avoidance）。两遍
/// 聚合（D-20② 元素先拷局部；首遍 first-seen 去重、次遍计数——列表
/// 元素定址替换未证形态，双遍规避）：行序 = first-seen（确定性，
/// tags_json/link_index 哲学同判）。**纯派生零 back 增量**（wanted
/// 面语义：link_pages 已知答案上聚合——SD-801）。
fn wanted_rows_of(pages List) List {
    var targets List = []
    var i int = 0
    while i < pages.len() {
        var page = pages[i]
        var links List = page.links
        var k int = 0
        while k < links.len() {
            var lnk = links[k]
            var ex bool = lnk.exists
            if !ex {
                var t str = lnk.target
                var seen bool = false
                var j int = 0
                while j < targets.len() {
                    var tj str = targets[j]
                    if tj == t {
                        seen = true
                    }
                    j = j + 1
                }
                if !seen {
                    targets.push(t)
                }
            }
            k = k + 1
        }
        i = i + 1
    }
    var out List = []
    var t2 int = 0
    while t2 < targets.len() {
        var target str = targets[t2]
        var n int = 0
        var i2 int = 0
        while i2 < pages.len() {
            var page2 = pages[i2]
            var links2 List = page2.links
            var k2 int = 0
            while k2 < links2.len() {
                var lnk2 = links2[k2]
                var ex2 bool = lnk2.exists
                if !ex2 {
                    var t3 str = lnk2.target
                    if t3 == target {
                        n = n + 1
                    }
                }
                k2 = k2 + 1
            }
            i2 = i2 + 1
        }
        out.push({ target: target, count: n, label: target + "（" + n.str() + "）" })
        t2 = t2 + 1
    }
    return out
}

widget App {
    msg {
        Init, FtToggle(str), OpenFile(str), Reload,
        Edit(str), TabActivate(int), CloseTab(int),
        ConfirmClose, ConfirmCancel,
        ActNew, ActOpen, ActSave, ActQuit,
        ActUndo, ActRedo, ActCut, ActCopy, ActPaste, ActSelectAll,
        ActConsole, ActSwitchTab, ActAbout,
        CloseRequest, QuitDiscard, QuitSaveClose, QuitConfirmCancel,
        ActBacklinks, LinksRefresh, OpenLink(str),
        MentionsRefreshOf(str), LinkifyGo(str),
        FindEdit(str), FindRun, ActFindFiles, ActFindText, FindPick(str),
        CreateClick(str), CreateGo, CreateCancel,
        TreeRefresh, LinksRefreshOf(str),
        RenameOpen, RenameEdit(str), RenameGo, RenameCancel,
        ActNewFile, NewEdit(str), NewGo, NewCancel, ActDelete,
        DeleteGo, DeleteCancel,
        ActTags, TagToggle(str), TagsRefresh,
        ActFindWanted,
        ActMeta, MetaEditTags(str), MetaEditAliases(str), MetaGo, MetaCancel,
    }

    model {
        var status str = "boot"
        // —— FileTree（bps L1 零副本）：fs.tree JSON 直连（节点 schema
        // {id,label,children,kind,icon,is_leaf,badge} 同构，to_fs_nodes
        // 转换器随 PLAN-001 退役）+ 展开态 + 选中态；行派生 computed
        // ft_rows = flatten_tree 纯函数，树行在根视图渲染 ——
        var ft_nodes = []
        var ft_expanded = []
        var ft_sel str = ""
        var ws_name str = ""
        // —— 链接索引（PLAN-003；触发点：Init / Save 成功 / 面板开启——
        // fetch+parse 在 App 上下文；行派生触点 = 一切激活档可能变化的
        // handler，见 on 块「链接行重算」注）——
        var links_json str = ""
        var link_pages List = []
        var bl_rows List = []
        var ol_rows List = []
        // —— 查找面板数据态（PLAN-004）：查询词/行集/已运行旗标——检索
        // 空态两形（未运行提示/运行后无结果）以 find_ran 区分；数据不入
        // store（D-20④ 同款裁定，链接态先例）。----
        var find_q str = ""
        var find_rows List = []
        var find_ran bool = false
        // —— 重命名弹层数据态（PLAN-006）：input 值（RenameOpen handler
        // 预填现 stem）——find_q 同构，不入 store（D-20④ 同款裁定）。
        var rename_q str = ""
        // —— 新建弹层数据态（PLAN-007）：input 值（ActNewFile 置空）——
        // rename_q 同构，不入 store（D-20④ 同款裁定）。删除弹层零新
        // 字段（目标 = ft_sel；预览 = link_pages/tabs 现场派生 computed）。
        var new_q str = ""
        // —— 页面属性弹层数据态（PLAN-011）：双 input 值（ActMeta 预填
        // 回显——page_meta GET 单取形，缺席键项 = 空初值；逗号分隔串
        // 形态 SD-1101）——rename_q 同构，不入 store（D-20④ 同款裁定）。
        var meta_q_tags str = ""
        var meta_q_aliases str = ""
        // —— 标签面板数据态（PLAN-008）：聚合行 {tag,label,paths}
        //（label 派生期拼接——双段 ${} 插值 avoidance，PLAN-003 先例）+
        // 单选展开态（"" = 全收，手风琴 v1）——find_q 同构不入 store
        //（D-20④ 同款裁定：find/链接态先例）。----
        var tags_rows List = []
        var tag_expanded str = ""
        // —— wanted 模式数据态（PLAN-008）：悬空目标聚合行
        // {target,count,label}——link_pages 派生（重算挂 LinksRefreshOf
        // 同触点 + ActFindWanted 入口；tags_rows 同判不入 store——
        // D-20④）。----
        var wanted_rows List = []
        // —— 未链接提及数据态（PLAN-009）：提及行 {path, snippet}——
        // search_wiki(stem) 结果 −自身 −已链源（bl_rows）−title-only
        // （SD-901 mentions 半）。**唯一新模型字段**（store 零新增——
        // App 模型族 find/链接/tags 态先例；基线 v9 变更面）。fetch =
        // MentionsRefreshOf 共享口（backlinks_open 守卫——面板关零
        // POST，D-21 面纪律）。----
        var mention_rows List = []
    }

    computed {
        ft_rows => flatten_tree(.ft_nodes, .ft_expanded, true, .ft_sel)
        // 悬空建页弹层路径预览（PLAN-005）：title_to_path 镜像消费
        // .store.create_target（widget computed——ft_rows 同族先例）。
        create_preview => title_to_path(.store.create_target)
        // 重命名影响面预览（PLAN-006）：link_pages × 现 stem 精确计数
        //（rename_impact_text 纯函数——仅弹层显示，权威在 back）。
        rename_preview => rename_impact_text(.link_pages, path_stem(.store.active_path))
        // 删除影响面预览两行（PLAN-007）：悬空化计数 + tab 关闭面——
        // 目标 = ft_sel（App 模型，ActDelete 守卫非空保证）；仅弹层
        // 显示（权威在 back 单事务删除 + 悬空化 SD-701）。
        delete_dangling_preview => dangling_impact(.link_pages, path_stem(.ft_sel))
        delete_tabs_preview => tabs_impact_text(.store.tabs, .ft_sel)
    }

    // —— actions 声明块（Plan 451 三源绑定：shortcut / toolbar 占位合成 /
    // MCP；enabled_if/checked_if 对合并根 state 求值）——基座同位（view 前）。
    actions {
        action (id: "file.new",    handler: .ActNew,    title: "新建",  icon: "file-plus",   shortcut: "Ctrl+N")
        action (id: "file.open",   handler: .ActOpen,   title: "打开…", icon: "folder-open", shortcut: "Ctrl+O")
        action (id: "file.save",   handler: .ActSave,   title: "保存",  icon: "save",        shortcut: "Ctrl+S",
                enabled_if: ".store.tab_count > 0")
        action (id: "file.rename", handler: .RenameOpen, title: "重命名…", shortcut: "F2",
                enabled_if: ".store.active_path != \"\" && !.store.active_dirty")
        action (id: "file.meta", handler: .ActMeta, title: "页面属性…", icon: "sliders-horizontal", shortcut: "Ctrl+I")
        action (id: "file.delete", handler: .ActDelete, title: "删除…", shortcut: "Delete",
                enabled_if: ".ft_sel != \"\"")
        action (id: "file.quit",   handler: .ActQuit,   title: "退出",  shortcut: "Alt+F4")
        action (id: "edit.undo",   handler: .ActUndo,   title: "撤销",  icon: "undo-2",      shortcut: "Ctrl+Z")
        action (id: "edit.redo",   handler: .ActRedo,   title: "重做",  icon: "redo-2",      shortcut: "Ctrl+Y")
        action (id: "edit.cut",    handler: .ActCut,    title: "剪切",  icon: "scissors")
        action (id: "edit.copy",   handler: .ActCopy,   title: "复制",  icon: "copy")
        action (id: "edit.paste",  handler: .ActPaste,  title: "粘贴",  icon: "clipboard")
        action (id: "edit.select-all", handler: .ActSelectAll, title: "全选", shortcut: "Ctrl+A")
        action (id: "view.console",    handler: .ActConsole,    title: "切换 Console", icon: "terminal", shortcut: "Ctrl+J",
                checked_if: ".store.console_open")
        action (id: "view.backlinks",  handler: .ActBacklinks,  title: "切换反链", icon: "link-2", shortcut: "Ctrl+L",
                checked_if: ".store.backlinks_open")
        action (id: "view.tags",       handler: .ActTags,       title: "切换标签", icon: "tag",   shortcut: "Ctrl+T",
                checked_if: ".store.tags_open")
        action (id: "view.find-files", handler: .ActFindFiles, title: "快速打开", icon: "file-search", shortcut: "Ctrl+P")
        action (id: "view.find-text",  handler: .ActFindText,  title: "全文检索", icon: "search", shortcut: "Ctrl+Shift+F",
                checked_if: ".store.find_open && .store.find_mode == \"text\"")
        action (id: "view.find-wanted", handler: .ActFindWanted, title: "悬空清单", shortcut: "Ctrl+Shift+D",
                checked_if: ".store.find_open && .store.find_mode == \"wanted\"")
        action (id: "view.switch-tab", handler: .ActSwitchTab,  title: "切换 Tab", shortcut: "Ctrl+D")
        action (id: "view.reload",    handler: .Reload,    title: "重载",  icon: "refresh-cw",   shortcut: "F5",
                enabled_if: ".store.tab_count > 0")
        action (id: "help.about",  handler: .ActAbout,  title: "关于 jade-edit")

        toolbar {
            item (action: "file.new")
            item (action: "file.open")
            item (action: "file.save")
            item (action: "view.reload")
            sep
            item (action: "edit.undo")
            item (action: "edit.redo")
        }
    }

    view {
        col (style: "h-full w-full") {

            // —— 顶栏：menubar + toolbar（基座 chrome）——
            row (style: "h-8 items-center bg-muted/30 shrink-0 w-full gap-0 px-2") {
                menubar (class: "items-center") {
                    menubar-menu (value: "file") {
                        menubar-trigger "文件"
                        menubar-content {
                            menubar-item (title: "新建", icon: "file-plus", shortcut: "Ctrl+N") { onclick: .ActNew }
                            menubar-item (title: "打开…", icon: "folder-open", shortcut: "Ctrl+O") { onclick: .ActOpen }
                            menubar-item (title: "保存", icon: "save", shortcut: "Ctrl+S", enabled: .store.tab_count > 0) { onclick: .ActSave }
                            // 重命名/删除项不挂 enabled——vm 轨 menubar-item
                            // 状态相关 enabled boot 冻结（T-02 实勘：boot
                            // 渲染定 handler 有无，状态变化不重评；复合式
                            // `!`/`&&` 更致节点整丢）——禁用语义由 handler
                            // 守卫兜底（action enabled_if 仍为权威面），
                            // 差异入 ledger v9。
                            menubar-item (title: "重命名…", shortcut: "F2") { onclick: .RenameOpen }
                            menubar-item (title: "页面属性…", icon: "sliders-horizontal", shortcut: "Ctrl+I") { onclick: .ActMeta }
                            menubar-item (title: "删除…", shortcut: "Delete") { onclick: .ActDelete }
                            menubar-separator
                            menubar-item (title: "退出", icon: "log-out", shortcut: "Alt+F4") { onclick: .ActQuit }
                        }
                    }
                    menubar-menu (value: "edit") {
                        menubar-trigger "编辑"
                        menubar-content {
                            menubar-item (title: "撤销", icon: "undo-2", shortcut: "Ctrl+Z") { onclick: .ActUndo }
                            menubar-item (title: "重做", icon: "redo-2", shortcut: "Ctrl+Y") { onclick: .ActRedo }
                            menubar-separator
                            menubar-item (title: "剪切", icon: "scissors") { onclick: .ActCut }
                            menubar-item (title: "复制", icon: "copy") { onclick: .ActCopy }
                            menubar-item (title: "粘贴", icon: "clipboard") { onclick: .ActPaste }
                            menubar-item (title: "全选", shortcut: "Ctrl+A") { onclick: .ActSelectAll }
                        }
                    }
                    menubar-menu (value: "view") {
                        menubar-trigger "视图"
                        menubar-content {
                            menubar-checkbox-item (title: "切换 Console", icon: "terminal", checked: .store.console_open, shortcut: "Ctrl+J") { onclick: .ActConsole }
                            menubar-checkbox-item (title: "切换反链", icon: "link-2", checked: .store.backlinks_open, shortcut: "Ctrl+L") { onclick: .ActBacklinks }
                            menubar-checkbox-item (title: "切换标签", icon: "tag", checked: .store.tags_open, shortcut: "Ctrl+T") { onclick: .ActTags }
                            menubar-item (title: "快速打开", icon: "file-search", shortcut: "Ctrl+P") { onclick: .ActFindFiles }
                            menubar-checkbox-item (title: "全文检索", icon: "search", checked: .store.find_open && .store.find_mode == "text", shortcut: "Ctrl+Shift+F") { onclick: .ActFindText }
                            menubar-checkbox-item (title: "悬空清单", checked: .store.find_open && .store.find_mode == "wanted", shortcut: "Ctrl+Shift+D") { onclick: .ActFindWanted }
                            menubar-item (title: "切换 Tab", shortcut: "Ctrl+D") { onclick: .ActSwitchTab }
                            menubar-item (title: "重载", icon: "refresh-cw", shortcut: "F5", enabled: .store.tab_count > 0) { onclick: .Reload }
                        }
                    }
                    menubar-menu (value: "help") {
                        menubar-trigger "帮助"
                        menubar-content {
                            menubar-item (title: "关于 jade-edit", icon: "info") { onclick: .ActAbout }
                        }
                    }
                }
                toolbar (style: "ml-auto") {}
            }

            // —— 主区：explorer 树（行留根）+ 编辑区（tab 条 + 编辑器）——
            row (style: "flex-1 items-stretch overflow-hidden w-full") {
                col (style: "w-56 shrink-0 border-r border-border bg-card hidden md:flex flex-col gap-2 p-2 overflow-y-auto") {
                    // EXPLORER 头部行：标题 + 「＋」新建钮（PLAN-007——tab
                    // 条 plus 钮同构：button + icon "plus"；入口 =
                    // .ActNewFile 开新建弹层，落盘新档语义——与 Ctrl+N
                    // untitled 草稿两口径并存，语境区隔 SD-701）。
                    row (style: "items-center justify-between px-1 pt-1") {
                        text "EXPLORER" { style: "text-[11px] text-muted-foreground tracking-wider" }
                        button (variant: "text") {
                            icon (name: "plus", style: "h-3.5 w-3.5 text-muted-foreground") {}
                            onclick: .ActNewFile
                            style: "h-5 w-5 px-0 py-0"
                        }
                    }
                    // 双段 ${} 插值 vue 发射错序（基座在册生成器 bug）——拆单段。
                    text .ws_name { style: "text-[11px] text-muted-foreground px-1" }
                    text .status { style: "text-[11px] text-muted-foreground px-1 pb-1" }
                    for r in .ft_rows {
                        row (style: "items-center") {
                            for g in r.guides {
                                if g == "l" {
                                    div (style: "w-4 h-6 flex items-center justify-center") {
                                        div (style: "w-px h-6 bg-border") {}
                                    }
                                } else {
                                    div (style: "w-4 h-6") {}
                                }
                            }
                            if r.has_kids {
                                mouse-area (onclick: .FtToggle(r.id), style: "w-5 h-5 shrink-0 items-center justify-center cursor-pointer") {
                                    if r.open {
                                        icon (name: "chevron-down", style: "w-3.5 h-3.5 text-muted-foreground") {}
                                    } else {
                                        icon (name: "chevron-right", style: "w-3.5 h-3.5 text-muted-foreground") {}
                                    }
                                }
                            } else {
                                div (style: "w-5 h-5 shrink-0") {}
                            }
                            TreeIcon (name: r.icon) {}
                            // 单按钮全行（vue 生成器对 v-for 内互补兄弟 template
                            // 对丢作用域——T-03 实勘；目录/文件分流在 OpenFile
                            // handler 按 .ad 后缀判别）。
                            button (text: r.label, variant: "ghost") {
                                onclick: .OpenFile(r.id)
                                style: "flex-1 px-1 text-left text-sm"
                            }
                        }
                    }
                }

                col (style: "flex-1 overflow-hidden") {
                    // —— tab 条（激活/非激活双分支留根：形状定位锚）——
                    // tab 标题钮 = OpenLink(t.path)（Open 已开即激活 + 链接
                    // 行派生共用口；TabActivate 索引口留 store 内部用）。
                    row (style: "h-8 items-center bg-muted/30 shrink-0 w-full gap-0") {
                        for i, t in .store.tabs {
                            if i == .store.tab {
                                row (style: "items-center bg-[#1C1D24]") {
                                    button (text: t.title, variant: "text") {
                                        onclick: .OpenLink(t.path)
                                        style: "h-8 px-3 text-[12px] text-foreground font-medium"
                                    }
                                    if t.dirty {
                                        text "*" { style: warn_label }
                                    }
                                    button (variant: "text") {
                                        icon (name: "x", style: "h-3 w-3 text-muted-foreground") {}
                                        onclick: .CloseTab(i)
                                        style: "h-7 w-6 px-0 py-0 mr-2"
                                    }
                                }
                            }
                            if i != .store.tab {
                                row (style: "items-center") {
                                    button (text: t.title, variant: "text") {
                                        onclick: .OpenLink(t.path)
                                        style: "h-8 px-3 text-[12px] text-muted-foreground"
                                    }
                                    if t.dirty {
                                        text "*" { style: warn_label }
                                    }
                                }
                            }
                        }
                        button (variant: "text") {
                            icon (name: "plus", style: "h-3.5 w-3.5 text-muted-foreground") {}
                            onclick: .ActOpen
                            style: "h-7 w-7 px-0 py-0 ml-1"
                        }
                    }
                    col (style: "h-px w-full bg-border shrink-0")

                    // —— 编辑区（autodown_editor；key 变即重挂载读 content:）——
                    if .store.tab_count > 0 {
                        autodown_editor (key: .store.active_key, final: true, style: "flex-1 w-full") {
                            content: .store.active_body
                            oninput: .Edit
                        }
                    }
                    if .store.tab_count == 0 {
                        col (style: "flex-1 w-full items-center justify-center") {
                            text "没有打开的文档 — 从左侧文件树打开" {
                                style: "text-[13px] text-muted-foreground"
                            }
                        }
                    }

                    if .store.console_open {
                        ConsolePanel()
                    }
                }

                // —— 右栏：查找面板（PLAN-004，上方）+ 反链/出链面板
                //（PLAN-003）+ 标签面板（PLAN-008）——三面板独立开关可
                // 叠放（§2.3 布局）。壳组件 = FindPanel/BacklinksPanel/
                // TagsPanel；input/行集/空态留根（MCP 快照锚不进组件子
                // 树，console_panel 同判）。行数据 = App 模型（vm 轨
                // store 上下文解析损坏，见模型注）。
                if .store.find_open || .store.backlinks_open || .store.tags_open {
                    col (style: "w-72 shrink-0 border-l border-border bg-card hidden md:flex flex-col overflow-y-auto") {
                        if .store.find_open {
                            FindPanel()
                            // 输入行：input + 检索钮（files/text 两模式
                            // ——wanted 纯清单无 input 行/无触发钮，
                            // PLAN-008 三分支）。
                            if .store.find_mode != "wanted" {
                            row (style: "items-center gap-1 px-2 py-1 shrink-0") {
                                if .store.find_mode == "files" {
                                    input {
                                        value: .find_q
                                        oninput: .FindEdit
                                        placeholder: "过滤文件名…"
                                        style: "flex-1 h-7 px-2 text-[12px] border rounded bg-background"
                                    }
                                }
                                if .store.find_mode == "text" {
                                    input {
                                        value: .find_q
                                        oninput: .FindEdit
                                        onenter: .FindRun
                                        placeholder: "输入查询词…"
                                        style: "flex-1 h-7 px-2 text-[12px] border rounded bg-background"
                                    }
                                    button (text: "检索", variant: "ghost") {
                                        onclick: .FindRun
                                        style: "h-7 px-2 text-[12px] shrink-0"
                                    }
                                }
                            }
                            }
                            // files 模式：即时过滤行集 + 空态（拾取即关——
                            // FindPick 口）。
                            if .store.find_mode == "files" {
                                if .find_rows.len() == 0 {
                                    text "（无匹配文件）" { style: "text-[11px] text-muted-foreground px-3" }
                                }
                                for r in .find_rows {
                                    button (text: r.path, variant: "ghost") {
                                        onclick: .FindPick(r.path)
                                        style: "w-full justify-start px-3 h-6 text-left text-[12px]"
                                    }
                                }
                            }
                            // text 模式：空态两形（find_ran 区分——未运行
                            // 提示/运行后无结果）+ 行集（检索浏览语义——行
                            // 点击开档面板保持开）。
                            if .store.find_mode == "text" {
                                if !.find_ran {
                                    text "（输入查询词后检索）" { style: "text-[11px] text-muted-foreground px-3" }
                                }
                                if .find_ran {
                                    if .find_rows.len() == 0 {
                                        text "（无结果）" { style: "text-[11px] text-muted-foreground px-3" }
                                    }
                                    for r in .find_rows {
                                        button (text: r.path, variant: "ghost") {
                                            onclick: .FindPick(r.path)
                                            style: "w-full justify-start px-3 h-6 text-left text-[12px]"
                                        }
                                    }
                                }
                            }
                            // wanted 模式（PLAN-008）：纯清单零 input——
                            // 悬空目标聚合行（label = `{target}（{n}）`）→
                            // 行点击 `.CreateClick` 直连 PLAN-005 建页弹层
                            //（预填 target——「发现→建页→消缺」闭环）；
                            // 空态留根（消缺后达成）。
                            if .store.find_mode == "wanted" {
                                if .wanted_rows.len() == 0 {
                                    text "（无悬空链接）" { style: "text-[11px] text-muted-foreground px-3" }
                                }
                                for r in .wanted_rows {
                                    button (text: r.label, variant: "ghost") {
                                        onclick: .CreateClick(r.target)
                                        style: "w-full justify-start px-3 h-6 text-left text-[12px] text-muted-foreground"
                                    }
                                }
                            }
                        }
                        if .store.backlinks_open {
                            BacklinksPanel()
                            row (style: "h-6 items-center shrink-0 px-3") {
                                text "反链" { style: "text-[11px] font-bold text-muted-foreground" }
                            }
                            if .bl_rows.len() == 0 {
                                text "（无反链）" { style: "text-[11px] text-muted-foreground px-3" }
                            }
                            for r in .bl_rows {
                                button (text: r.source_path, variant: "ghost") {
                                    onclick: .OpenLink(r.source_path)
                                    style: "w-full justify-start px-3 h-6 text-left text-[12px]"
                                }
                            }
                            row (style: "h-6 items-center shrink-0 px-3") {
                                text "出链" { style: "text-[11px] font-bold text-muted-foreground" }
                            }
                            if .ol_rows.len() == 0 {
                                text "（无出链）" { style: "text-[11px] text-muted-foreground px-3" }
                            }
                            for r in .ol_rows {
                                if r.exists {
                                    button (text: r.target, variant: "ghost") {
                                        onclick: .OpenLink(r.target_path)
                                        style: "w-full justify-start px-3 h-6 text-left text-[12px]"
                                    }
                                }
                                // 悬空行 button 化（PLAN-005）——建页入口
                                //（旧「非点击文本」形态随本切片退役；确认
                                // 弹层误触防线，§2.3）。
                                if !r.exists {
                                    button (text: "${r.target}（悬空）", variant: "ghost") {
                                        onclick: .CreateClick(r.target)
                                        style: "w-full justify-start px-3 h-6 text-left text-[12px] text-muted-foreground"
                                    }
                                }
                            }
                            // —— 未链接提及段（PLAN-009；SD-901 mentions
                            // 半——反链面板第三段，Obsidian 反链面板同款
                            // 段落）：标题行 + 空态 + 行集两行留根（button
                            // path + text snippet 次行——非单钮双段插值，
                            // §5.2）；行点击 OpenLink 开档。数据 =
                            // .mention_rows（MentionsRefreshOf 共享口守卫
                            // fetch——面板关零 POST）。----
                            row (style: "h-6 items-center shrink-0 px-3") {
                                text "未链接提及" { style: "text-[11px] font-bold text-muted-foreground" }
                            }
                            if .mention_rows.len() == 0 {
                                text "（无未链接提及）" { style: "text-[11px] text-muted-foreground px-3" }
                            }
                            for r in .mention_rows {
                                row (style: "w-full items-center justify-between") {
                                    button (text: r.path, variant: "ghost") {
                                        onclick: .OpenLink(r.path)
                                        style: "flex-1 justify-start px-3 h-6 text-left text-[12px]"
                                    }
                                    button (text: "转为链接", variant: "text") {
                                        onclick: .LinkifyGo(r.path)
                                        style: "text-[11px] h-5 px-2 text-muted-foreground shrink-0"
                                    }
                                }
                                text r.snippet { style: "text-[11px] text-muted-foreground px-3" }
                            }
                        }
                        // —— 标签面板区（PLAN-008）：tag 行（label 派生期
                        // 拼接 `{tag} · {n}`——双段插值 avoidance）→ 单选
                        // 手风琴展开页行 → OpenLink 导航；空态留根。----
                        if .store.tags_open {
                            TagsPanel()
                            if .tags_rows.len() == 0 {
                                text "（无标签）" { style: "text-[11px] text-muted-foreground px-3" }
                            }
                            for r in .tags_rows {
                                button (text: r.label, variant: "ghost") {
                                    onclick: .TagToggle(r.tag)
                                    style: "w-full justify-start px-3 h-6 text-left text-[12px]"
                                }
                                if .tag_expanded == r.tag {
                                    for p in r.paths {
                                        button (text: p, variant: "ghost") {
                                            onclick: .OpenLink(p)
                                            style: "w-full justify-start px-3 h-6 text-left text-[12px]"
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // —— 关闭脏 tab 确认（基座 Plan 420 P2 / 626 T-06 形态）——
            alert-dialog (open: .store.confirm_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        alert-dialog-title "有未保存的修改"
                        alert-dialog-description "关闭前要保存吗?"
                    }
                    alert-dialog-footer {
                        alert-dialog-cancel "取消" { onclick: .ConfirmCancel }
                        alert-dialog-action "直接关闭" { onclick: .ConfirmClose }
                    }
                }
            }

            // —— 退出/关窗确认（窗口 X 与「退出」共用入口）——
            alert-dialog (open: .store.quit_confirm_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        alert-dialog-title "有未保存的修改"
                        alert-dialog-description "退出前要保存吗?"
                    }
                    alert-dialog-footer {
                        alert-dialog-cancel "取消" { onclick: .QuitConfirmCancel }
                        alert-dialog-action "不保存退出" { onclick: .QuitDiscard }
                        alert-dialog-action "保存并退出" { onclick: .QuitSaveClose }
                    }
                }
            }

            // —— 悬空建页确认（PLAN-005 第三切片；旧园 CreatePagePrompt
            //「Create missing page?」先例移植——alert-dialog 在册族第三
            // 实例）。路径预览 = title_to_path front 镜像（create_preview
            // computed——仅显示，权威在 back）。——
            alert-dialog (open: .store.create_confirm_open) {
                alert-dialog-content {
                    alert-dialog-header {
                        alert-dialog-title "创建缺失页面？"
                        alert-dialog-description "[[${.store.create_target}]] 尚不存在"
                    }
                    text "将创建：${.create_preview}" { style: "text-[12px] text-muted-foreground px-1" }
                    alert-dialog-footer {
                        alert-dialog-cancel "取消" { onclick: .CreateCancel }
                        alert-dialog-action "创建" { onclick: .CreateGo }
                    }
                }
            }

            // —— 新建页面弹层（PLAN-007 第五切片；dialog 第四实例——
            // 内嵌 input，重命名弹层同构形态：双钮 = 普通 button[D-24④
            // 纪律]、闭态恒渲染 D-23③ 同判——测试定位锚内容制；声明位
            // 在 rename 弹层前——vm 快照 input 序「弹层后声明者居末」
            // 锚纪律，check 12 rename input 居末不漂移）。创建 = 复用
            // create_page（PLAN-005 全套：幂等/清洗/模板/根落位）。——
            dialog (open: .store.new_open) {
                dialog-content {
                    dialog-header {
                        dialog-title "新建页面"
                        dialog-description "在工作区根创建新页面"
                    }
                    input {
                        value: .new_q
                        oninput: .NewEdit
                        placeholder: "页面名…"
                        style: "w-full h-7 px-2 text-[12px] border rounded bg-background"
                    }
                    dialog-footer {
                        button (text: "取消", variant: "outline") { onclick: .NewCancel }
                        button (text: "创建", variant: "ghost") { onclick: .NewGo }
                    }
                }
            }

            // —— 页面属性弹层（PLAN-011 第九切片；dialog 第六实例——
            // 双 input（标签/别名逗号分隔），重命名弹层同构形态：双钮 =
            // 普通 button[dialog-cancel/action vm 轨死标签轨间不对称，
            // 禁用 D-24④ 纪律]、闭态恒渲染 D-23③ 同判——测试定位锚内容
            // 制。声明位在 rename 弹层前——vm 快照 input 序「弹层后声明
            // 者居末」锚纪律（check 12 rename input 居末不漂移）。预填
            // 回显 = ActMeta 单取形 fetch（page_meta GET——缺席键项 =
            // 空初值）；值权威在 back 单事务受控改写（D-14 三原则）。——
            dialog (open: .store.meta_open) {
                dialog-content {
                    dialog-header {
                        dialog-title "页面属性"
                        dialog-description "标签与别名（逗号分隔）——${.store.active_title}"
                    }
                    input {
                        value: .meta_q_tags
                        oninput: .MetaEditTags
                        placeholder: "标签（逗号分隔）…"
                        style: "w-full h-7 px-2 text-[12px] border rounded bg-background"
                    }
                    input {
                        value: .meta_q_aliases
                        oninput: .MetaEditAliases
                        placeholder: "别名（逗号分隔）…"
                        style: "w-full h-7 px-2 text-[12px] border rounded bg-background"
                    }
                    dialog-footer {
                        button (text: "取消", variant: "outline") { onclick: .MetaCancel }
                        button (text: "保存", variant: "ghost") { onclick: .MetaGo }
                    }
                }
            }

            // —— 重命名弹层（PLAN-006 第四切片；dialog 控件族首个用例——
            // 内嵌 input 探针 B 定谳形态：双钮 = 普通 button[dialog-cancel/
            // action vm 轨死标签轨间不对称，禁用]、闭态恒渲染 D-23③ 同判
            // ——测试定位锚内容制）。影响面预览 = rename_preview computed
            //（仅显示，权威在 back 单事务改写）。——
            dialog (open: .store.rename_open) {
                dialog-content {
                    dialog-header {
                        dialog-title "重命名页面"
                        dialog-description "现名：${.store.active_title}"
                    }
                    input {
                        value: .rename_q
                        oninput: .RenameEdit
                        placeholder: "新名称…"
                        style: "w-full h-7 px-2 text-[12px] border rounded bg-background"
                    }
                    text .rename_preview { style: "text-[12px] text-muted-foreground px-1" }
                    dialog-footer {
                        button (text: "取消", variant: "outline") { onclick: .RenameCancel }
                        button (text: "重命名", variant: "ghost") { onclick: .RenameGo }
                    }
                }
            }

            // —— 删除页面弹层（PLAN-007 第五切片；dialog 第五实例——
            // 重命名弹层同构形态：双钮 = 普通 button[D-24④ 纪律]、闭
            // 态恒渲染 D-23③ 同判。零新字段：目标 = ft_sel（App 模型，
            // ActDelete 守卫非空保证）；影响面预览两行 = dangling_impact
            // / tabs_impact_text 纯函数 computed（仅显示，权威在 back
            // 单事务删除——入链悬空化不改写源文 SD-701，「N 处入链将变
            // 为悬空」预告即防线）。声明位在 rename 弹层后——零 input
            // 故 input 序锚不受扰；「删除」钮全树唯一（文本定位无歧义
            //），取消 = 其父行兄弟域。——
            dialog (open: .store.delete_open) {
                dialog-content {
                    dialog-header {
                        dialog-title "删除页面"
                        dialog-description "将删除 ${.ft_sel}"
                    }
                    text .delete_dangling_preview { style: "text-[12px] text-muted-foreground px-1" }
                    text .delete_tabs_preview { style: "text-[12px] text-muted-foreground px-1" }
                    dialog-footer {
                        button (text: "取消", variant: "outline") { onclick: .DeleteCancel }
                        button (text: "删除", variant: "ghost") { onclick: .DeleteGo }
                    }
                }
            }

            StatusBar()
        }
    }

    on {
        // Init 名保留给根 widget 生命周期（store 侧 handler 不得占用）。
        // merged 形态 = 进程内直调；split/vue = HTTP——缺席容错落
        // backend-offline（不炸 boot——六检查前置卫生）。
        .Init -> {
            // Init 名保留给根 widget 生命周期（store 侧 handler 不得占用）。
            // 树取段/链接首刷提取共享（TreeRefresh/LinksRefreshOf——PLAN-005
            // T-03 重构，语句等价迁移；merged 缺席容错落 backend-offline
            // 不炸 boot——六检查前置卫生，原形态保留在共享口内）。
            .TreeRefresh()
            .LinksRefreshOf("")
            .TagsRefresh()
            .MentionsRefreshOf("")
        }

        // 目录展开/折叠（受控展开态，toggle_id 纯函数返回新 List）。
        .FtToggle(id) -> {
            .ft_expanded = toggle_id(.ft_expanded, id)
        }

        // 行点击分流：无 .ad 尾 = 目录行 → 展开/折叠；有 .ad 尾 = 文件行 →
        // store Open（单按钮面——vue 兄弟模板作用域 workaround，见 view 注记；
        // 非 .ad 文件行落 toggle 为无害 no-op，v0 容忍）。
        .OpenFile(path) -> {
            var parts = path.split(".ad")
            if parts.len() == 1 {
                .FtToggle(path)
            } else {
                .ft_sel = path
                store.Open({ path: path })
                // 链接行重算（显式 path——handler 内 .store 读为陈旧投影，
                // T-03 实勘；Open 即激活入参 path，两轨一致）
                .bl_rows = backlink_rows_of(.link_pages, path)
                .ol_rows = outlink_rows_of(.link_pages, path)
                .MentionsRefreshOf(path)
            }
        }

        // INPUT_TEXT 全文回写 → store Edit（投影在 store 内重算）。
        .Edit(text) -> {
            store.Edit(text)
        }

        .TabActivate(i) -> { store.TabActivate(i) }
        .Reload -> { store.Reload() }
        .CloseTab(i) -> { store.CloseTab(i) }
        .ConfirmClose -> { store.ConfirmClose() }
        .ConfirmCancel -> { store.ConfirmCancel() }
        .ActNew -> {
            store.ActNew()
            // 链接行重算（显式空 active——untitled 激活；不读 .store，两轨一致）
            .bl_rows = backlink_rows_of(.link_pages, "")
            .ol_rows = outlink_rows_of(.link_pages, "")
            .MentionsRefreshOf("")
        }
        .ActOpen -> { store.ActOpen() }
        .ActSave -> {
            store.Save()
            // 保存改变出链面 → 链接索引重取（触发集：Save 成功）+ **树重取
            //（G3 新档顺收：untitled 落盘后树陈旧至重开的先在面——Save 后
            // 恒重取，失败保存的重取为无害幂等，省 store 成功态读回的
            // 陈旧投影面）**。行 active = .store.active_path 读回（Save 对
            // 具名档不改 active；untitled 先落路径 rare 分支 vm 轨留陈旧
            // 行，下次触点校正——先在语义保持）。
            .TreeRefresh()
            .LinksRefreshOf(.store.active_path)
            .TagsRefresh()
            .MentionsRefreshOf(.store.active_path)
        }
        .ActQuit -> { store.ActQuit() }
        .ActUndo -> { store.ActUndo() }
        .ActRedo -> { store.ActRedo() }
        .ActCut -> { store.ActCut() }
        .ActCopy -> { store.ActCopy() }
        .ActPaste -> { store.ActPaste() }
        .ActSelectAll -> { store.ActSelectAll() }
        .ActConsole -> { store.ActConsole() }
        .ActBacklinks -> {
            store.BacklinksToggle()
            if .store.backlinks_open {
                // 面板开启 → 链接索引重取（触发集：面板开启）+ 行重算
                // + 提及重取（PLAN-009——行重算先行，bl_rows 已链源排重
                // 面现算；面板关零 POST 守卫在口内）
                .LinksRefreshOf(.store.active_path)
                .MentionsRefreshOf(.store.active_path)
            }
        }
        .LinksRefresh -> {
            // 手动/程序化刷新入口（触发集外补充；当前 UI 无直连入口，
            // 保留 msg 面——面板壳刷新钮后续批接线）。
            .LinksRefreshOf(.store.active_path)
        }

        // —— 树取共享口（PLAN-005 T-03 提取自 Init 内联段；G3 触点 =
        // 建页成功 / Save 新档 + Init + **重命名成功**（PLAN-006——
        // EXPLORER 旧行消失新行在）+ **删除成功**（PLAN-007——
        // EXPLORER 行消失；触发集 v4 = v3 + 删除成功，新建直承
        // 「建页成功」口））。fetch+parse 必须 handler 体内
        //（json.to_value 模块函数体被 ts_adapter 静默恒等——T-04 实勘；
        // store 上下文 vmref 损坏 D-20④）——故共享以 msg handler 形态
        // 收口（五触点同款理由）。
        .TreeRefresh -> {
            var root str = ""
            var nodes List = []
            try {
                root = ws_root()
                nodes = json.to_value(tree(root, 4))
                .ft_nodes = nodes
                .ws_name = file_basename(root)
                .status = "ready"
            } catch (e) {
                .status = "backend-offline"
            }
        }

        // —— 链接索引重取共享口（PLAN-005 T-03 提取；触发集 v4 = Init
        // / Save 成功/面板开启/**建页成功**（.CreateGo/.NewGo 直承）+
        // **重命名成功**（.RenameGo——v3 扩）+ **删除成功**（.DeleteGo
        // ——PLAN-007 v4 扩：入链/出链行 exists=false 翻转）+ 手动口
        // LinksRefresh）。
        // ⚠ to_value 双取形：ts_adapter 只对 call-arg
        // 发射 JSON.parse（identifier 实参静默降恒等——D-20⑤），原文态
        // links_json 与解析态分两次取（fetch 幂等，v0 规模双取无害）。
        // active 显式入参：开档流（CreateGo）传新档 path——handler 内
        // .store 读为陈旧投影（T-03 实勘），其余触点传 .store.active_path
        //（语义同前提）。
        .LinksRefreshOf(active str) -> {
            var lj str = ""
            var lp List = []
            var lok bool = true
            try {
                lj = link_index("", 4)
                .links_json = lj
                lp = json.to_value(link_index("", 4))
            } catch (e) {
                lok = false
            }
            if !lok {
                console_log("links: refresh failed")
            }
            .link_pages = lp
            .bl_rows = backlink_rows_of(.link_pages, active)
            .ol_rows = outlink_rows_of(.link_pages, active)
            // wanted 行重算挂同触点（PLAN-008——link_pages 变化即消缺：
            // 建页成功后 wanted 行自动消失，G2 闭环）
            .wanted_rows = wanted_rows_of(.link_pages)
            // 提及重算串联（PLAN-010）：link_pages 就绪后刷新提及，
            // 确保 mentions_of 消费新鲜的 backlink_rows_of 排重源，
            // 消除 vue 轨并发 fetch 时序竞态（D-26② 闭环）。
            .MentionsRefreshOf(active)
        }

        // —— 未链接提及重取共享口（PLAN-009 T-02；SD-901 mentions 半）。
        // 守卫链（§5.2）：backlinks_open 为真才 fetch（面板关零 POST——
        // D-21 面纪律；merged 臂网络不可观测，面板关时激活变更
        // mention_rows 恒旧值的行为等价断言面见 vm_matrix link 组
        // mentions 子步）→ active 非空（untitled 恒空）→ 单取形 fetch
        // search_wiki(stem, 20)（PLAN-004 契约原样——POST 通道 CJK 双臂
        // 已证 D-19 面无）→ mentions_of 三则过滤装配。
        // ⚠ 已链源集**本口自派生**（backlink_rows_of(.link_pages,
        // active)——不直读 .bl_rows）：vue 轨 handler 间调用不发射
        // await（D-23②），ActBacklinks 等处 LinksRefreshOf 与本口并发——
        // 直读 .bl_rows 会吃到 pre-refresh 陈旧投影（e2e check-10 实勘：
        // 已链源漏排重三行误入提及段）；.link_pages 为最近一次完成的
        // 索引刷新产物，与面板在显反链行同鲜度——提及排重与所见一致
        // 口径。stem = path_stem(active)（D-20③ split 法）。try/catch
        // 落 console_log（链接触点同款——backend-offline 不炸；D-25①：
        // 零 .console 写面）。触点族 = Init/ActBacklinks 开面板/OpenFile/
        // OpenLink/ActNew（激活变更——守卫内）/Save 成功/Rename 成功
        //（与 bl/ol 行重算同触点族，v3/v4 集内不扩新触发类别）。
        .MentionsRefreshOf(active str) -> {
            if .store.backlinks_open {
                if active != "" {
                    var stem str = path_stem(active)
                    var rows List = []
                    var ok bool = true
                    try {
                        rows = json.to_value(search_wiki(stem, 20))
                    } catch (e) {
                        ok = false
                    }
                    if !ok {
                        console_log("mentions: search failed")
                    }
                    .mention_rows = mentions_of(rows, active, backlink_rows_of(.link_pages, active))
                } else {
                    .mention_rows = []
                }
            }
        }
        // —— 提及转链接（PLAN-010 T-02；SD-1001 linkify 半）：
        // path 档正文内 stem 改写为 [[stem]]（frontmatter 保留）；
        // stem = path_stem(.store.active_path)（D-20③ split 法）。
        // 成功（!= "0" && != ""）→ LinksRefreshOf + MentionsRefreshOf 自派生刷新
        // （D-26② 纪律：零跨 fetch 投影读；D-25①：零 .console 写面）。
        .LinkifyGo(path str) -> {
            if path != "" {
                if .store.active_path != "" {
                    var stem str = path_stem(.store.active_path)
                    var res str = ""
                    var ok bool = true
                    try {
                        res = linkify_page(path, stem)
                    } catch (e) {
                        ok = false
                    }
                    if !ok {
                        console_log("linkify: failed")
                    }
                    if res != "0" {
                        if res != "" {
                            console_log("linkify: converted " + res + " mention(s)")
                            .LinksRefreshOf(.store.active_path)
                            .MentionsRefreshOf(.store.active_path)
                        }
                    }
                }
            }
        }
        .OpenLink(path) -> {
            if path != "" {
                store.Open({ path: path })
                // 链接行重算（显式 path——tab 条/面板行点击共用本口：
                // Open 已开即激活语义 + 行派生）
                .bl_rows = backlink_rows_of(.link_pages, path)
                .ol_rows = outlink_rows_of(.link_pages, path)
                .MentionsRefreshOf(path)
            }
        }

        // —— 标签索引重取共享口（PLAN-008 T-02；触发集 = 链接域 v4 同口
        // 多一 fetch 不扩集：Init / Save 成功 / 面板开启 / 建页成功
        //（.CreateGo/.NewGo 直承）/ 重命名成功（.RenameGo）/ 删除成功
        //（.DeleteGo）+ 开关口 .ActTags）。
        // fetch 单取形：tags 只需解析态 → call-arg 形直入 json.to_value
        //（D-20⑤：call-arg 形发射 JSON.parse——免双取，比 links 面简一
        // 档）。行 label 派生期拼接（`{tag} · {n}`——双段 ${} 插值
        // avoidance，PLAN-003 先例）。
        .TagsRefresh -> {
            var rows List = []
            var ok bool = true
            try {
                rows = json.to_value(tags_index("", 4))
            } catch (e) {
                ok = false
            }
            if !ok {
                console_log("tags: refresh failed")
            }
            var out List = []
            var i int = 0
            while i < rows.len() {
                // ⚠ D-20②：列表元素先拷局部变量再取字段。
                var r = rows[i]
                var paths List = r.paths
                out.push({ tag: r.tag, label: r.tag + " · " + paths.len().str(), paths: paths })
                i = i + 1
            }
            .tags_rows = out
        }
        // 标签面板入口（Ctrl+T/菜单/menubar 共口——BacklinksToggle 同构
        // 第三实例）：开 → 重取（触发集：面板开启）。D-25① 纪律：App
        // 上下文零 `.console` 写面（console 面由 store handler 自维护）。
        .ActTags -> {
            store.TagsToggle()
            if .store.tags_open {
                .TagsRefresh()
            }
        }
        // tag 行单选手风琴（v1——再点同 tag 收起；点他 tag 换选）。
        .TagToggle(tag) -> {
            if .tag_expanded == tag {
                .tag_expanded = ""
            } else {
                .tag_expanded = tag
            }
        }

        // —— 查找面板（PLAN-004 T-02/T-03）——
        // 输入分流：files 模式即时过滤（纯内存零 fetch——SD-401 刷新触发
        // 集=无）；text 模式只更 find_q（触发面 = 检索钮/onenter——探针 C）。
        .FindEdit(q) -> {
            .find_q = q
            if .store.find_mode == "files" {
                .find_rows = file_rows_of(collect_ad_paths(.ft_nodes), q)
            }
        }
        // 检索触发（text 模式）：fetch search_wiki（POST 通道——D-19 适配）
        // + **双取形**（⚠ ts_adapter 只对 call-arg 形发射 JSON.parse，
        // identifier 实参静默降恒等——D-20⑤，Init link_index 同款；此处
        // rows 直接收解析产物，单次调用即双取形合规）+ 行装配 + find_ran。
        // try/catch 落 console_log（链接触点同款——backend-offline 不炸）。
        .FindRun -> {
            var rows List = []
            var ok bool = true
            try {
                rows = json.to_value(search_wiki(.find_q, 20))
            } catch (e) {
                ok = false
            }
            if !ok {
                console_log("find: search failed")
            }
            .find_rows = rows
            .find_ran = true
        }
        // 快开入口（幂等重开——已开则保模式清过滤面）；行集就绪待过滤
        //（空 q = 全量清单）。
        .ActFindFiles -> {
            store.FindOpen("files")
            .find_rows = file_rows_of(collect_ad_paths(.ft_nodes), .find_q)
        }
        // 全文检索入口（幂等重开 + 切模式）；行集不动——text 面板由
        // find_ran 门控渲染（未运行提示优先，files 期残留行不泄漏）。
        .ActFindText -> {
            store.FindOpen("text")
        }
        // wanted 模式入口（PLAN-008；Ctrl+Shift+D/菜单共口——find-text
        // 同构第三模式）：幂等重开 + 切模式 + 链接索引重取（入口即刷新
        // ——wanted 行集 = link_pages 派生，重取后悬空面新鲜；行重算在
        // .LinksRefreshOf 内联，bl/ol 行随 active 同步）。D-25① 纪律：
        // App 上下文零 `.console` 写面。
        .ActFindWanted -> {
            store.FindOpen("wanted")
            .LinksRefreshOf(.store.active_path)
        }
        // 查找行点击口：OpenLink 共用导航口（开档 + 链接行派生）；files
        // 模式拾取即关（store FindClose 关口——开态权威单点）；text 模式
        // 保持开（检索结果浏览语义）。
        .FindPick(path) -> {
            .OpenLink(path)
            if .store.find_mode == "files" {
                store.FindClose()
            }
        }

        // —— 悬空建页（PLAN-005 T-02/T-03）——悬空行点击 → 确认弹层
        //（store 弹层态）→ 创建流或取消。CreateGo 四步流（§2.3）：
        .CreateClick(target) -> {
            store.CreateConfirmOpen(target)
        }
        .CreateCancel -> {
            store.CreateConfirmCancel()
        }
        // CreateGo 四步流（§2.3）：
        // ①back 契约直调（try/catch 落 console——backend-offline 不炸）
        // ②成功 = 关弹层 + 开新档（OpenLink 共用导航口——显式 path 两轨
        //  一致 + 行重算）③链接索引重取（触发集 v2：建页成功——悬空行
        //  exists 翻转）④树重取（G3——EXPLORER 新行 + 快开 ft_nodes
        //  数据源随之新鲜）。失败/空名守卫 = 弹层留置 + console 注记
        //（用户可取消）。
        .CreateGo -> {
            var r str = ""
            var ok bool = true
            try {
                r = create_page(.store.create_target)
            } catch (e) {
                ok = false
            }
            if !ok {
                console_log("create: failed")
            }
            if r != "" {
                store.CreateConfirmCancel()
                .OpenLink(r)
                .LinksRefreshOf(r)
                .TagsRefresh()
                .TreeRefresh()
            }
        }
        // —— 新建页面流（PLAN-007 T-02；§2.3）——
        // 入口 = EXPLORER「＋」钮：input 置空 + 开弹层（无守卫——任意
        // 时刻可新建；Ctrl+N untitled 草稿流不动，语境区隔 SD-701）。
        .ActNewFile -> {
            .new_q = ""
            store.NewOpen()
        }
        .NewEdit(q) -> {
            .new_q = q
        }
        .NewCancel -> {
            store.NewClose()
        }
        // NewGo 流（§2.3；CreateGo 四步流同构——back 半直承 PLAN-005）：
        // ①back 契约直调 create_page（try/catch 落 console——backend-
        //   offline 不炸；幂等守卫/清洗/模板/根落位全套在册）
        // ②成功 = 关弹层 + store.Open（直口——已开即激活/新开播种）+
        //   链接索引重取（触发集 v4：「建页成功」口直承——行重算内联
        //   active=r，显式 r 两轨一致规避 handler 内 .store 陈旧投影）+
        //   树重取（EXPLORER 新行 + 快开 ft_nodes 数据源新鲜）+ ft_sel
        //   置位新行
        // ③拒（""，空名清洗守卫）= console 注记 + 弹层留置（用户可改
        //   名重试/取消——PLAN-006 v1 口径同判）。
        .NewGo -> {
            var r str = ""
            var ok bool = true
            try {
                r = create_page(.new_q)
            } catch (e) {
                ok = false
            }
            if !ok {
                console_log("create: failed")
            }
            if r != "" {
                store.NewClose()
                store.Open({ path: r })
                .LinksRefreshOf(r)
                .TagsRefresh()
                .TreeRefresh()
                .ft_sel = r
            } else {
                if ok {
                    console_log("create: rejected (empty name)")
                }
            }
        }

        // —— 删除入口（PLAN-007 T-02 落 action/menubar 面；T-03 弹层/
        // 执行流）：守卫 = ft_sel 空拒（G2 未选中 no-op——console 注记 +
        // 零弹层；action enabled_if 同公式权威面，menubar 项不挂 enabled
        // ——D-24③ boot 冻结纪律，handler 守卫兜底）。
        .ActDelete -> {
            if .ft_sel == "" {
                console_log("delete: no selection")
            } else {
                store.DeleteOpen()
            }
        }
        .DeleteCancel -> {
            store.DeleteClose()
        }
        // 删除流（§2.3；RenameGo 同构守卫面）：
        // ①back 契约直调 delete_page（try/catch 落 console——backend-
        //   offline 不炸；目标先拷局部（.ft_sel——弹层开启后无改写源，
        //   直读等价）
        // ②成功 = 关弹层 + store.CloseTabsOf（该档全部 tab 关闭——激活
        //   邻档补位/空态两案在 RemoveAt 在册口免费收口）+ 链接索引重取
        //   （触发集 v4：**删除成功**——入链/出链行 exists=false 翻转，
        //   active = CloseTabsOf 后投影 .store.active_path）+ 树重取
        //   （EXPLORER 行消失）+ ft_sel 清空（删除后无选中——未选中
        //   Delete no-op 口径复位）
        // ③拒（""：非 .ad/缺失/删后仍在）= console 注记 + 弹层留置
        //   （用户可取消/重试——PLAN-006 v1 口径同判）。
        .DeleteGo -> {
            var target str = .ft_sel
            var r str = ""
            var ok bool = true
            try {
                r = delete_page(target)
            } catch (e) {
                ok = false
            }
            if !ok {
                console_log("delete: failed")
            }
            if r != "" {
                store.DeleteClose()
                store.CloseTabsOf(r)
                .LinksRefreshOf(.store.active_path)
                .MentionsRefreshOf(.store.active_path)
                .TagsRefresh()
                .TreeRefresh()
                .ft_sel = ""
            } else {
                if ok {
                    console_log("delete: rejected (not-.ad/missing/gone)")
                }
            }
        }

        .ActSwitchTab -> { store.ActSwitchTab() }
        .ActAbout -> { store.ActAbout() }
        .CloseRequest -> { store.CloseRequest() }
        .QuitDiscard -> { store.QuitDiscard() }
        .QuitSaveClose -> { store.QuitSaveClose() }
        .QuitConfirmCancel -> { store.QuitConfirmCancel() }

        // —— 重命名流（PLAN-006 T-02/T-03）——
        // 入口（action F2/menubar 共口）：守卫与 enabled_if 同公式
        //（vm 轨 menubar enabled 对 press 的门控双轨未证——handler 侧
        // 复核为语义兜底，禁用态断言以此为准）；预填 = 现 stem（split 法
        // 剥目录/尾——path_stem）。
        .RenameOpen -> {
            if .store.active_path != "" {
                if !.store.active_dirty {
                    store.RenameOpen()
                    .rename_q = path_stem(.store.active_path)
                }
            }
        }
        .RenameEdit(q) -> {
            .rename_q = q
        }
        .RenameCancel -> {
            store.RenameClose()
        }
        // 改名流四步（§2.3；PLAN-006 T-03）：
        // ①back 契约直调（try/catch 落 console——backend-offline 不炸；
        //   rename_page 为 api-client 调用，try-体 await 在册——D-23② 面
        //   无，CreateGo 同款形态）
        // ②成功 = 关弹层 + store.TabsRenamed（tab 路径/标题/key 全量更新
        //   ——key 变即重挂载播种）+ store.Reload（自链改写 Reload 显现
        //   ——store body 是改名前镜像，重读磁盘即改写后文；handler 内
        //   顺序 TabsRenamed → Reload，渲染滞后于 handler 完成故重挂载
        //   播种即新文）
        // ③链接索引重取（触发集 v3：**重命名成功**——反链/出链面板立即
        //   反映新 stem）+ 树重取（EXPLORER 旧行消失新行在）+ ft_sel 同步
        //   （选中行=旧路径则指向新路径）。行 active 显式传 r——handler
        //   内 .store 读为陈旧投影（T-03 实勘同款规避）。
        // ④拒（""）= console 注记 + 弹层留置（拒因前端不可见——v1 口径
        //   §10.5；用户可取消/改名重试）。
        .RenameGo -> {
            var r str = ""
            var ok bool = true
            try {
                r = rename_page(.store.active_path, .rename_q)
            } catch (e) {
                ok = false
            }
            if !ok {
                console_log("rename: failed")
            }
            if r != "" {
                var old_path str = .store.active_path
                store.RenameClose()
                store.TabsRenamed(old_path, r)
                store.Reload()
                .LinksRefreshOf(r)
                .TagsRefresh()
                .MentionsRefreshOf(r)
                .TreeRefresh()
                if .ft_sel == old_path {
                    .ft_sel = r
                }
            } else {
                if ok {
                    console_log("rename: rejected (conflict/case-only/missing/empty)")
                }
            }
        }

        // —— 页面属性流（PLAN-011 T-02/T-03）——
        // 入口（action Ctrl+I/menubar 共口）：守卫 untitled no-op（action
        // 不挂 enabled——D-24③ vm 轨 menubar-item enabled 冻结缺口，
        // handler 复核为语义兜底）。预填回显 = page_meta GET 单取形
        //（json.to_value call-arg 形——D-20⑤ 免双取；缺席键项 = 空初值
        //；CJK 路径 split 臂 D-19 降级空态——§10 记账）。D-25① 纪律：
        // App 上下文零 `.console` 写面。
        .ActMeta -> {
            if .store.active_path != "" {
                store.MetaOpen()
                .meta_q_tags = ""
                .meta_q_aliases = ""
                var rows List = []
                var ok bool = true
                try {
                    rows = json.to_value(page_meta(.store.active_path))
                } catch (e) {
                    ok = false
                }
                if !ok {
                    console_log("meta: load failed")
                }
                var i int = 0
                while i < rows.len() {
                    // ⚠ D-20②：列表元素先拷局部变量再取字段。
                    var r = rows[i]
                    if r.key == "tags" {
                        .meta_q_tags = r.value
                    }
                    if r.key == "aliases" {
                        .meta_q_aliases = r.value
                    }
                    i = i + 1
                }
            }
        }
        .MetaEditTags(v) -> {
            .meta_q_tags = v
        }
        .MetaEditAliases(v) -> {
            .meta_q_aliases = v
        }
        .MetaCancel -> {
            store.MetaClose()
        }
        // 保存流（§2.3）：set_page_meta POST（try/catch 落 console——
        // backend-offline 不炸；D-19 body 传参 CJK 值常态）→ "ok" =
        // 关弹层 + 自派生刷新族（D-26② 纪律——零跨 fetch 投影读）：
        // LinksRefreshOf（alias 解析面——出链 exists 翻转/wanted 派生随
        // 产物；内链 MentionsRefreshOf 链式尾——010 在册形态）+
        // TagsRefresh（tags 面板新行即时可见）；tree 不刷（无文件名变
        // 化）。非 "ok" = console 注记 + 弹层留置（006 v1 口径同判——
        // 拒因前端不可见，用户可取消/重试）。
        .MetaGo -> {
            var r str = ""
            var ok bool = true
            try {
                r = set_page_meta(.store.active_path, .meta_q_tags, .meta_q_aliases)
            } catch (e) {
                ok = false
            }
            if !ok {
                console_log("meta: save failed")
            }
            if r == "ok" {
                store.MetaClose()
                .LinksRefreshOf(.store.active_path)
                .TagsRefresh()
            } else {
                if ok {
                    console_log("meta: save rejected")
                }
            }
        }
    }
}
