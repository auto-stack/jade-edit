// editor_store.at — EditorStore：tabs/脏标/保存流 + 基座 chrome 状态
// （PLAN-001 T-01 换基融合：骨架 = auto-edit PLAN-003 交付的 EditorStore，
// 编辑器通道 = 本仓 PLAN-081 已实证的 autodown_editor 形态）。
//
// 融合要点（相对基座的差异）：
//   - 编辑器无 code_editor_* 内建（autodown_editor 只有 key/content/final/
//     oninput/on_focus 事件面——T-00 实勘）→ 剪贴板/undo/fold 族 handler
//     降级 no-op + console 注记；行:列光标三元组不可得（无 oncursor）。
//   - tab 身份 = path（untitled 走 key 兜底）；编辑器 key = active_key，
//     key 变即重挂载读 content: 播种通道（PLAN-081 T-03 结论沿用）。
//   - 数据面全走 back.api（merged=进程内直调 / split·vue=HTTP）：
//     read_wiki 只回 body——frontmatter 由 back 侧保留/拼回（JsonAny
//     损坏类结构性消除，PLAN-081 T-03 的「现读现传」绕法退役）。
//   - 状态权威与显示投影全在 store；App 视图经 `.store.*` 读（vue/vm
//     双轨合法消费面——PLAN-081 T-06 结论沿用：合并根状态裸读仅 vm
//     成立；store computed 双轨皆坏，派生标量由 handler 就地重算）。

use back.api: read_wiki, write_wiki, exists, env_str, draft_begin, draft_alloc, draft_checkpoint, draft_settle, draft_list, draft_read, draft_read_orig

// ".ad" 后缀剥离（tab 标题 = path 末段去扩展）。⚠ split 法（T-03 实勘）：
// length+slice 在 CJK heap 串上字节/字符错位（.length 字节语义）——
// ends_with 判定 + split(".ad")[0] 剥尾（文件名内嵌 ".ad" 病理形态不支
// 持——与 wsys stem 同限）。【PLAN-031 T-01 勘注 2026-09-30：现役工具链
// .length/.char_at 已为字符（标量）语义（auto-lang PLAN-055，探针
// "中中".length=2 实证）——split 法保留（行为等价且免 slice 语义纠缠），
// 字节面需求走 fs.size（back 侧）；本注释历史形态不抹】。
fn strip_ad(path str) str {
    if path.ends_with(".ad") {
        var parts = path.split(".ad")
        return parts[0]
    }
    return path
}

// 受影响域包含判定（lp1 记录域解析伴生件——PLAN-032 T-03）：items 表内
// 精确相等（D-11 禁 .find 闭包——while 扫描在册形态）。
fn lc_list_has(items List, v str) bool {
    var out bool = false
    var i int = 0
    while i < items.len() {
        var s str = items[i]
        if s == v {
            out = true
        }
        i = i + 1
    }
    return out
}

// "*" 分隔记录域包含判定（rewrites 域命中面）
fn lc_field_has(field str, v str) bool {
    if field == "" {
        return false
    }
    var parts = field.split("*")
    return lc_list_has(parts, v)
}

// 阻断清单 → 行集（title\u0001path\u0001reason | title…——label 预拼供视图
// 直读；解析容错：段不足三段时以整段为 label）
fn lc_block_rows_of(list str) List {
    var out List = []
    if list == "" {
        return out
    }
    var entries = list.split("|")
    var i int = 0
    while i < entries.len() {
        var e str = entries[i]
        if e != "" {
            var f = e.split("\u0001")
            if f.len() >= 3 {
                var t str = f[0]
                var rsn str = f[2]
                out.push({ label: t + " — " + rsn })
            } else {
                out.push({ label: e })
            }
        }
        i = i + 1
    }
    return out
}

// "|" 串重接（漂移候选清单收缩）
fn lc_join_pipe(items List) str {
    var out str = ""
    var i int = 0
    while i < items.len() {
        var s str = items[i]
        if s != "" {
            if out != "" {
                out = out + "|"
            }
            out = out + s
        }
        i = i + 1
    }
    return out
}

store EditorStore {
    model {
        // Tab 对象（key/path/title/body/original_body/dirty）。typed 声明
        // 纪律（裸 `= []` 在 VM 轨静默坏列表——PLAN-081 T-06）。
        var tabs Array<str> = []
        // str+"" 哨兵替代 ?str（"" 即无活动 tab）。
        var active_path str = ""
        var active_key str = ""
        // —— 显示投影（视图唯一读面 `.store.*`；handler 内就地重算）——
        var active_title str = ""
        var active_body str = ""
        var active_dirty bool = false
        var save_note str = ""
        // tab 索引镜像（tab 条分支读面；结构变化时由 handler 就地重算）。
        var tab int = -1
        var tab_count int = 0
        var open_count int = 0
        var edits int = 0
        // console 面板（console_log/console_lines 宿主内建）。
        var console_open bool = false
        var console str = ""
        // 关闭脏 tab 确认弹层（基座 Plan 420 P2）。
        var confirm_open bool = false
        var confirm_idx int = -1
        // 退出/关窗确认弹层（基座 Plan 626 T-06；窗口 X 与菜单退出共口）。
        var quit_confirm_open bool = false
        // 反链面板开关（PLAN-003；面板壳/菜单 checked_if 消费。链接数据
        // 态在 App 模型——vm 轨 store 上下文 json.to_value 产物损坏，T-03）。
        var backlinks_open bool = false
        // 查找面板开态 + 模式（PLAN-004；Ctrl+P/Ctrl+Shift+F 双快捷键
        // 分流的结果态，基线 v4 面。数据态在 App 模型——D-20④ 同款裁定：
        // store 上下文解析产物损坏，链接态先例）。
        var find_open bool = false
        var find_mode str = "files"
        // 悬空建页确认弹层（PLAN-005；基线 v5 面）：目标名 + 开态——
        // 弹层面状态居 store（confirm_open/quit_confirm_open 在册分野）。
        var create_confirm_open bool = false
        var create_target str = ""
        // 重命名弹层开态（PLAN-006；基线 v6 面）：弹层面分野同上——
        // input 值/影响面预览在 App 模型（数据态不入 store——D-20④ 同裁
        // 裁定：find_q/链接态先例）。
        var rename_open bool = false
        // 标签面板开关（PLAN-008；基线 v8 面。数据态在 App 模型——
        // D-20④ 同款裁定：find/链接态先例）。
        var tags_open bool = false
        // 新建/删除弹层开态（PLAN-007；基线 v7 面）：弹层面分野同
        // rename_open——new_q 在 App 模型；删除弹层零新字段（目标 =
        // App .ft_sel、预览 = link_pages/tabs 现场派生）。
        var new_open bool = false
        var delete_open bool = false
        // 页面属性弹层开态（PLAN-011；基线 v10 面）：弹层面分野同
        // rename_open——meta_q_tags/meta_q_aliases 在 App 模型（数据态
        // 不入 store——D-20④ 同款裁定：find_q/rename_q 先例）。
        var meta_open bool = false
        // 新建/移动目录弹层开态（PLAN-012；基线 v11 面）：弹层面分野同
        // rename_open——dir_q/move_q 在 App 模型（数据态不入 store——
        // D-20④ 同款裁定：new_q/rename_q 先例）。
        var dir_open bool = false
        var move_open bool = false
        // 删除/重命名目录弹层开态（PLAN-014；基线 v13 面）：弹层面分野
        // 同上——deldir_q/rendir_target/rendir_q 在 App 模型（数据态不入
        // store——D-20④ 同款裁定：dir_q/move_q 先例）。
        var deldir_open bool = false
        var rendir_open bool = false
        // —— 移动目录弹层开态（PLAN-018；基线 v16 面）：目录移动 = 低频
        // 组织操作，双 input 数据态在 App 模型（014 目录弹层族同裁定）。
        var movedir_open bool = false
        // —— 工作区规模警示（PLAN-021；基线 v19 面）：P≤200 试用防线态
        // ——App TreeRefresh 计数 >200 写入（WsWarn msg 单向通道），
        // StatusBar 条件行直读（组件只读 .store.*——App 模型字段不可见，
        // 计划 §4.2 落定位）。"" = 无警示（现行语料恒空——纯显示面，功
        // 能路径零影响）。
        var ws_warn str = ""
        // —— 手动重载受保护流（PLAN-030）：确认开态 + 发起时目标快照
        // 三标量。快照只在请求期间保留（取消/成功/失败/失效终态归零；
        // vue 轨 Escape 关闭走 v-model 只清开态——残置标量惰性，下次
        // RequestReload 重快照覆盖，editor-safety §边界注记）。本体仍由
        // tabs 管理，零第二份文档权威。----
        var reload_confirm_open bool = false
        var reload_target_key str = ""
        var reload_target_path str = ""
        var reload_target_body str = ""
        // 提交 nonce（PLAN-030 T-04 开发期实勘）：vue 轨引擎 round-trip 非
        // 字节保真（如正文首空行规范化剥除）——commit 写磁盘原文经
        // replaceDoc → onChange → emitUpdate(规范化文) 回声 .Edit，原文
        // ≠规范化文 → dirty 翻真（echo 污染）。commit 递增 nonce 改写
        // tab key → 编辑器 key 变 = 重挂载播种（挂载期零发射——引擎
        // lastEmittedMd 预播种语义），echo 路径整体绕开，双轨同源。
        var reload_nonce int = 0
        // —— 草稿检查点（PLAN-031 T-03）：会话代次（draft_begin 惰性取一
        // 次持值复用——重复调用会续增，T-01 定谳）；0 = 未取。----
        var draft_epoch int = 0
        // 待恢复条数提示（PLAN-031 T-04；App Init 单写口——StatusBar 条件
        // 行直读。0 = 无；>0 = 状态栏「待恢复草稿 N 条」入口提示——非模态
        // 不劫持（自动弹模态层被 T-04 实勘否决：劫持全应用点击面））。
        var recover_hint int = 0
        // —— 正常离开目标快照（PLAN-031 T-05；§5.4 表）：身份+正文修订
        // 快照取代 confirm_idx 索引依赖（异步流程中列表变化索引过期——
        // 计划 §4.2）。close_* = 关闭弹层目标；quit_* = 退出弹层批量捕获
        //（key 串行清单——身份定址逐项重查）。终态归零。----
        var close_target_key str = ""
        var close_target_path str = ""
        var close_target_body str = ""
        var close_target_doc str = ""
        var quit_keys str = ""
        // 重载放弃结算快照（PLAN-031 T-05；§5.4 表第八行）：请求期捕获
        // 目标草稿账（doc/seq/conf）+ 是否脏发起——成功读回且目标仍匹配
        // 时先结算被放弃草稿，**结算失败不提交正文替换**；取消/读取失
        // 败/失效不结算。终态归零。----
        var reload_target_doc str = ""
        var reload_target_seq int = 0
        var reload_target_conf int = 0
        var reload_was_dirty bool = false
        // —— 生命周期受检流（PLAN-032 T-03；契约 =
        // docs/plans/attachments/032-lifecycle-protocol.md §3/§4）。架构
        // 裁定：**App 发起全部 fetch（lc_plan/lc_commit/read_wiki 漂移
        // 探测），store 只做同步策略机**（门判定/快照/定向协调/保存门）
        // ——store 内零 fetch ⇒ App 在 msg 派发后同步读 verdict/basis/
        // moves 双轨成立（ActSave 先在语义同族）。----
        // tab_uid：会话内稳定实例 ID（Open/ActNew/DraftRecover 分配；关闭
        // 即逝；重开同路径 = 新实例——不依赖索引/key/doc_id）。
        var tab_seq int = 0
        // 单会话单操作在途（gate 就绪至 resolve/cancel——双击/并发入口
        // 不重复提交，AC-09；阻断弹层即出 hold=false 由用户处理后重新
        // 发起——重试必须重新分析）。
        var lc_hold bool = false
        // 在途操作冻结参数（请求期间活动页/输入框/选区变化不改目标）。
        var lc_kind str = ""
        var lc_a str = ""
        var lc_b str = ""
        var lc_c str = ""
        var lc_basis str = ""
        // 受影响实例快照 [{uid,path,body,orig,doc}]（提交前捕获；协调按
        // tab_uid 定址 + 正文仍匹配才同步——晚输入保留，AC-07/08）。
        var lc_snap Array<str> = []
        // 漂移探测候选（清洁匹配 tab 的 path 串行 "p1|p2"——App 逐个
        // read_wiki 后 LcDrift 回填；清空即门终判）。
        var lc_pending str = ""
        // 阻断弹层（操作名 + 受影响未保存/待同步文档清单——用户经既有
        // 保存/保留草稿关闭/明确放弃处理后重新发起；取消保持原操作未
        // 提交）。
        var lc_block_open bool = false
        var lc_block_list str = ""
        var lc_block_kind str = ""
        // 阻断行集（视图直读——label = title — reason 预拼，零视图内拼接）。
        var lc_block_rows Array<str> = []
        // App 读回面：verdict ∈ reject|blocked|drift|ok|done（gate/drift/
        // resolve 各阶段终态）；lc_moves = 回执 moves 域（App recents 键
        // 置换用——LcResolve 同步写入，双轨读回成立）。
        var lc_verdict str = ""
        var lc_moves str = ""
        var lc_status str = ""
    }

    // msg 载荷单类型（编译器约束）：Open 单 map、Edit 单 str。
    msg {
        Open(map), Edit(str), Save, Reload,
        RequestReload, ReloadCancel, ReloadDiscard, ReloadReadOf,
        DraftDrainOf(str), DraftSettleOf(str, int, str, int, str), DraftRecover(str, int, int, str, int),
        RecoverHint(int),
        CloseTab(int), RemoveAt(int), ConfirmClose, ConfirmCancel, ConfirmKeepClose,
        QuitKeepClose,
        TabActivate(int), ActNew, ActOpen, ActConsole, ActSwitchTab,
        ActUndo, ActRedo, ActCut, ActCopy, ActPaste, ActSelectAll, ActAbout,
        ActQuit, ConsoleClear, CloseRequest, QuitDiscard, QuitSaveClose,
        QuitConfirmCancel,
        BacklinksToggle,
        TagsToggle,
        FindOpen(str), FindToggle, FindClose,
        CreateConfirmOpen(str), CreateConfirmCancel,
        RenameOpen, RenameClose, TabsRenamed(str, str),
        NewOpen, NewClose, DeleteOpen, DeleteClose, CloseTabsOf(str),
        MetaOpen, MetaClose,
        DirOpen, DirClose, MoveOpen, MoveClose,
        DelDirOpen, DelDirClose, RenDirOpen, RenDirClose,
        MoveDirOpen, MoveDirClose,
        WsWarn(str),
        LcGate(str, str, str, str, str), LcDrift(str, str), LcResolve(str), LcBlockCancel,
    }

    on {
        // ---- 激活投影重算（tab 索引 → active_* 全套；tab_count 就地同步
        // ——Open/RemoveAt/ActNew 全走此口，防漏维护） ----
        .TabActivate(i) -> {
            .tab_count = .tabs.len()
            .tab = i
            .active_path = .tabs[i].path
            .active_key = .tabs[i].key
            .active_title = .tabs[i].title
            .active_body = .tabs[i].body
            .active_dirty = .tabs[i].dirty
        }

        // ---- Open({path})：已开 tab 激活；否则 exists 守卫 + 读盘新 tab ----
        //（TreeSelect 语义收口于此——树选/菜单打开/旁路打开同口）。
        .Open(args) -> {
            var path = args.path
            var found int = -1
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].path == path {
                    found = i
                }
                i = i + 1
            }
            if found < 0 {
                if exists(path) {
                    var body str = ""
                    var ok bool = true
                    try {
                        body = read_wiki(path)
                    } catch (e) {
                        ok = false
                    }
                    if ok {
                        .tab_seq = .tab_seq + 1
                        .tabs.push({
                            key: path,
                            path: path,
                            title: strip_ad(path),
                            body: body,
                            original_body: body,
                            dirty: false,
                            doc_id: "",
                            draft_erev: 0,
                            draft_state: "",
                            draft_seq: 0,
                            draft_conf: 0,
                            recover_src_doc: "",
                            recover_src_seq: 0,
                            recover_src_erev: 0,
                            tab_uid: .tab_seq,
                            lc_review: false,
                        })
                        found = .tabs.len() - 1
                        console_log("open: " + path)
                    } else {
                        .save_note = "read-failed: " + path
                    }
                } else {
                    .save_note = "not-found: " + path
                }
            }
            if found >= 0 {
                store.TabActivate(found)
            }
            .console = console_lines()
        }

        // ---- Edit(text)：INPUT_TEXT 单参全文回写（041 同约定）——就地
        // 变更 + 脏标重算 + 投影同步。tab 定位用 key+path 身份双查（
        // PLAN-030 RequestReload 同形态——不依赖列表索引）。变更即递增
        // 文档逻辑修订 draft_erev；脏 → 草稿检查点排水（PLAN-031 T-03：
        // 每 keystroke 触发 drain——单在-flight 合并等待，merged 臂同步
        // 完成即逐键落盘，vue/split 臂在-flight 期新输入只更新正文、由
        // 排水循环收尾时续发最新——run-to-completion 语义下无迟到竞态
        // 【await 悬窗外 handler 体原子】）；回原文（dirty 翻假）→ 结算
        // 旧草稿 discarded（失败提示并保留恢复记录）。----
        .Edit(text) -> {
            var j int = -1
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].key == .active_key {
                    if .tabs[i].path == .active_path {
                        j = i
                    }
                }
                i = i + 1
            }
            if j >= 0 {
                var changed bool = false
                if .tabs[j].body != text {
                    .tabs[j].body = text
                    .tabs[j].dirty = .tabs[j].body != .tabs[j].original_body
                    .tabs[j].draft_erev = .tabs[j].draft_erev + 1
                    .edits = .edits + 1
                    changed = true
                }
                .active_body = text
                .active_dirty = .tabs[j].dirty
                if changed {
                    if .tabs[j].dirty {
                        if .tabs[j].doc_id == "" {
                            if .draft_epoch == 0 {
                                .draft_epoch = draft_begin().parse_int()
                            }
                            .tabs[j].doc_id = draft_alloc()
                        }
                        if .tabs[j].doc_id != "" {
                            if .tabs[j].draft_state != "sending" {
                                store.DraftDrainOf(.tabs[j].doc_id)
                            }
                        } else {
                            .save_note = "草稿身份分配失败——正文未保护"
                            console_log("draft-error: alloc failed")
                        }
                    } else {
                        if .tabs[j].doc_id != "" {
                            if .tabs[j].draft_seq > 0 {
                                store.DraftSettleOf(.tabs[j].doc_id, .tabs[j].draft_seq, "discarded", .tabs[j].draft_conf, "")
                            }
                        }
                    }
                }
            }
        }

        // ---- 草稿检查点排水（PLAN-031 T-03；单文档单在-flight——调用
        // 方 Edit 保证 state != "sending" 才入口）。身份定址（doc_id 扫
        // 描重查——切页/关闭/改名期间稳定），合并等待写入：每次循环重取
        // 最新正文/修订，回执后 draft_erev 已前进则续发（在-flight 期新
        // 输入永不丢）；回执只结算其对应修订——旧成功回执不得覆盖新
        // 状态。终态：saved（无更新输入）/ error（回执失败——保留待重
        // 试，下次 Edit 再排水）。守卫 32 圈防病理性循环。----
        // 待恢复条数提示（App Init 单写口；DiscoverReload 行集变化后同刷）。
        .RecoverHint(n) -> {
            .recover_hint = n
        }

        .DraftDrainOf(doc_id) -> {
            var guard int = 0
            var stop bool = false
            while guard < 32 {
                if stop {
                    guard = 32
                } else {
                    guard = guard + 1
                    var f int = -1
                    var i int = 0
                    while i < .tabs.len() {
                        if .tabs[i].doc_id == doc_id {
                            f = i
                        }
                        i = i + 1
                    }
                    if f < 0 {
                        stop = true
                    } else {
                        if !.tabs[f].dirty {
                            stop = true
                        } else {
                            .tabs[f].draft_state = "sending"
                            var erev int = .tabs[f].draft_erev
                            var bodySnap str = .tabs[f].body
                            var origSnap str = .tabs[f].original_body
                            var r str = ""
                            var rok bool = true
                            try {
                                r = draft_checkpoint(doc_id, .draft_epoch, erev, .tabs[f].path, .tabs[f].title, bodySnap, origSnap)
                            } catch (e2) {
                                rok = false
                            }
                            if !rok {
                                r = "err:transport"
                            }
                            // 回执后身份重查（await 悬窗内切页/关闭/改名都可能）
                            var g int = -1
                            var k int = 0
                            while k < .tabs.len() {
                                if .tabs[k].doc_id == doc_id {
                                    g = k
                                }
                                k = k + 1
                            }
                            if g < 0 {
                                stop = true
                            } else {
                                var okhead bool = r.starts_with("ok:")
                                if okhead {
                                    var seqv int = r.substr(3, r.length - 3).parse_int()
                                    var first_ack bool = .tabs[g].draft_seq == 0
                                    .tabs[g].draft_seq = seqv
                                    .tabs[g].draft_conf = erev
                                    console_log("draft-saved: " + doc_id + ":" + erev.str())
                                    if .tabs[g].key == .active_key {
                                        .save_note = "草稿已保护"
                                    }
                                    if first_ack {
                                        if .tabs[g].recover_src_doc != "" {
                                            // 恢复副本首检确认 → 结算来源（recovered +
                                            // link=副本身份——来源条目按协议消费/去重）
                                            store.DraftSettleOf(.tabs[g].recover_src_doc, .tabs[g].recover_src_seq, "recovered", .tabs[g].recover_src_erev, doc_id)
                                        }
                                    }
                                    if .tabs[g].draft_erev > erev {
                                        // 等待期有新输入——继续排水最新（state 保持 sending）
                                    } else {
                                        .tabs[g].draft_state = "saved"
                                        stop = true
                                    }
                                } else {
                                    .tabs[g].draft_state = "error"
                                    if .tabs[g].key == .active_key {
                                        .save_note = "草稿保护失败：" + r
                                    }
                                    console_log("draft-error: " + doc_id + " " + r)
                                    stop = true
                                }
                            }
                        }
                    }
                }
            }
            // 守卫圈耗尽出口修正：state 残留 sending 会让后续 Edit 永不
            // 重排——尚有未确认修订时降级 pending（下次 Edit 再排水），
            // 已追平则收 saved。
            var f2 int = -1
            var i2 int = 0
            while i2 < .tabs.len() {
                if .tabs[i2].doc_id == doc_id {
                    f2 = i2
                }
                i2 = i2 + 1
            }
            if f2 >= 0 {
                if .tabs[f2].draft_state == "sending" {
                    if .tabs[f2].draft_erev > .tabs[f2].draft_conf {
                        .tabs[f2].draft_state = "pending"
                    } else {
                        .tabs[f2].draft_state = "saved"
                    }
                }
            }
        }

        // ---- 草稿结算（PLAN-031 T-03；回到原文 discarded / 保存成功
        // saved / 恢复副本确认 recovered[T-04]）。settle_erev = 结算目
        // 标修订——晚到的旧检查点不复活。成功且无更新确认时清文档草稿
        // 账（新确认已落地则保留其账）；失败提示并保留可追踪恢复记录
        // （AC-09：结算失败不破坏正文/记录）。----
        .DraftSettleOf(doc_id, seq, event, erev, link_id) -> {
            var r str = ""
            var rok bool = true
            try {
                r = draft_settle(doc_id, seq, event, link_id, erev)
            } catch (e) {
                rok = false
            }
            if !rok {
                r = "err:transport"
            }
            if r == "ok" {
                console_log("draft-settled: " + doc_id + ":" + seq.str() + " " + event)
                var f int = -1
                var i int = 0
                while i < .tabs.len() {
                    if .tabs[i].doc_id == doc_id {
                        f = i
                    }
                    i = i + 1
                }
                if f >= 0 {
                    if .tabs[f].draft_conf <= erev {
                        .tabs[f].draft_seq = 0
                        .tabs[f].draft_conf = 0
                        .tabs[f].draft_state = ""
                    }
                }
            } else {
                .save_note = "草稿结算失败（已保留恢复记录）"
                console_log("draft-settle-failed: " + doc_id + ":" + seq.str() + " " + r)
            }
            .console = console_lines()
        }

        // ---- 恢复副本播种（PLAN-031 T-04；App .RecoverCopy 薄委托）：
        // draft_read/draft_read_orig 读回（len 对照——空文 len==0 合法，
        // 读取失败/不一致拒绝播种）→ 独立身份新 tab（path 空 + 标记来源
        // 三字段 + original_body="" → 非空副本恒 dirty 需另存；**空文副
        // 本 body==original_body 不构成普通清洁判定吞没**——副本状态由
        // 来源结算链路独立追踪，AC-05）。读取失败不动现有 tab。----
        .DraftRecover(doc_id, seq, len, name, erev) -> {
            var body str = ""
            var rok bool = true
            try {
                body = draft_read(doc_id, seq)
            } catch (e8) {
                rok = false
            }
            var oklen bool = rok
            if len > 0 {
                if body == "" {
                    oklen = false
                }
            }
            if oklen {
                var orig str = ""
                try {
                    orig = draft_read_orig(doc_id, seq)
                } catch (e9) {
                    orig = ""
                }
                .open_count = .open_count + 1
                var nm str = "recovered-" + .open_count.str()
                var dt str = name
                if dt == "" {
                    dt = "未命名"
                }
                .tab_seq = .tab_seq + 1
                .tabs.push({
                    key: nm,
                    path: "",
                    title: dt + "（恢复副本）",
                    body: body,
                    original_body: "",
                    dirty: body != "",
                    doc_id: "",
                    draft_erev: 0,
                    draft_state: "",
                    draft_seq: 0,
                    draft_conf: 0,
                    recover_src_doc: doc_id,
                    recover_src_seq: seq,
                    recover_src_erev: erev,
                    tab_uid: .tab_seq,
                    lc_review: false,
                })
                .tab_count = .tabs.len()
                store.TabActivate(.tab_count - 1)
                console_log("recovered: " + doc_id + ":" + seq.str() + " -> " + nm)
                if body == "" {
                    .save_note = "已恢复空文副本（来源草稿仍保留，另存后消费）"
                }
            } else {
                .save_note = "恢复失败：草稿读取未通过完整性核验"
                console_log("recover-failed: " + doc_id + ":" + seq.str())
            }
            .console = console_lines()
        }

        // ---- Save：untitled 先落路径（AUTO_SAVE_PATH 旁路 → dialog_save）；
        // write_wiki 的 back 侧保 frontmatter（front 零 JsonAny）。
        // PLAN-031 T-03 保存快照门：写入前捕获身份/路径/正文/修订四元
        // 快照；写盘成功后**读回核验**（read_wiki == 提交正文——存在性
        // 不再作为成功判据，AC-08）；核验通过才更新原文基准并重算脏标
        // （较新输入经比较自动保持 dirty——旧成功不清新脏）；绑定结算
        // saved（settle_erev = 保存快照修订——等待期新输入的检查点不被
        // 结算）；取消/写失败/核验失败均保留编辑态与草稿。----
        .Save -> {
            var j int = -1
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].key == .active_key {
                    if .tabs[i].path == .active_path {
                        j = i
                    }
                }
                i = i + 1
            }
            if j >= 0 {
                if .tabs[j].lc_review {
                    if .tabs[j].path != "" {
                        // 待核验门（PLAN-032 T-03，AC-10）：未知结果/正文外
                        // 改差异标记接入 Save——禁按原路径覆盖；出口 = 另存
                        //（path 置空态走既有 Save As）或重新核验。
                        .save_note = "此文档待核验——请先另存为新文件，或重新核验后再保存"
                        console_log("save-blocked: review " + .tabs[j].path)
                        .console = console_lines()
                    }
                }
            }
            if j >= 0 {
                var lc_gate_ok bool = true
                if .tabs[j].lc_review {
                    if .tabs[j].path != "" {
                        lc_gate_ok = false
                    }
                }
                if lc_gate_ok {
                var save_doc str = .tabs[j].doc_id
                var save_erev int = .tabs[j].draft_erev
                var save_body str = .tabs[j].body
                if .tabs[j].path == "" {
                    var p str = env_str("AUTO_SAVE_PATH")
                    if p == "" {
                        p = dialog_save("untitled.ad")
                    }
                    if p != "" {
                        .tabs[j].path = p
                        .tabs[j].key = p
                        .tabs[j].title = strip_ad(p)
                        .tabs[j].lc_review = false
                    }
                }
                if .tabs[j].path != "" {
                    var saved bool = write_wiki(.tabs[j].path, save_body)
                    if saved {
                        var back str = ""
                        var okb bool = true
                        try {
                            back = read_wiki(.tabs[j].path)
                        } catch (e) {
                            okb = false
                        }
                        if okb {
                            if back == save_body {
                                // 读回一致 = 该快照保存成功：原文基准 = 提交快照，
                                // 脏标重算（较新输入自动保持 dirty——AC-08）
                                var k int = -1
                                var m int = 0
                                while m < .tabs.len() {
                                    if .tabs[m].key == .active_key {
                                        if .tabs[m].path == .tabs[j].path {
                                            k = m
                                        }
                                    }
                                    m = m + 1
                                }
                                if k >= 0 {
                                    .tabs[k].original_body = save_body
                                    .tabs[k].dirty = .tabs[k].body != .tabs[k].original_body
                                    .active_path = .tabs[k].path
                                    .active_key = .tabs[k].key
                                    .active_title = .tabs[k].title
                                    .active_body = .tabs[k].body
                                    .active_dirty = .tabs[k].dirty
                                    if .tabs[k].draft_seq > 0 {
                                        store.DraftSettleOf(.tabs[k].doc_id, .tabs[k].draft_seq, "saved", save_erev, "")
                                    }
                                    if .tabs[k].recover_src_doc != "" {
                                        // 恢复副本 Save As 成功 = 内容已持久 → 来源结算
                                        //（settle 幂等重写同墓碑——重复触发无害）
                                        store.DraftSettleOf(.tabs[k].recover_src_doc, .tabs[k].recover_src_seq, "recovered", .tabs[k].recover_src_erev, .tabs[k].doc_id)
                                    }
                                }
                                .save_note = "saved: " + .tabs[j].path
                                console_log("saved: " + .tabs[j].path)
                            } else {
                                .save_note = "save-verify-failed: " + .tabs[j].path
                                console_log("save-verify-failed: " + .tabs[j].path)
                            }
                        } else {
                            .save_note = "save-verify-failed: " + .tabs[j].path
                            console_log("save-verify-failed: " + .tabs[j].path)
                        }
                    } else {
                        .save_note = "save-failed: " + .tabs[j].path
                    }
                } else {
                    .save_note = "save: cancelled"
                }
                }
            }
            .console = console_lines()
        }

        // ---- Reload：强制重读激活 tab（六检查「保存落盘 → 重载可见」通道）。
        // ⚠ 内部业务同步口（改名/移动/目录迁移流在册调用边界，PLAN-030 起
        // 与用户手动口分野——用户 F5/菜单/工具栏走 RequestReload 受保护
        // 流，不得误接回此口）。----
        .Reload -> {
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].path == .active_path {
                    var body str = ""
                    var ok bool = true
                    try {
                        body = read_wiki(.tabs[i].path)
                    } catch (e) {
                        ok = false
                    }
                    if ok {
                        .tabs[i].body = body
                        .tabs[i].original_body = body
                        .tabs[i].dirty = false
                        .active_body = body
                        .active_dirty = false
                        .save_note = "reloaded: " + .tabs[i].path
                    }
                }
                i = i + 1
            }
        }

        // ---- 手动重载受保护流（PLAN-030；三用户入口共口——F5/菜单/工具
        // 栏经 App .Reload 薄委托到此）：未保存先确认（开态+目标快照，
        // 不读盘）；干净直入受保护读盘。身份 = tab key+path（不依赖列表
        // 索引）。等待/读盘期间的新输入、切页、关档一律拒绝旧结果覆盖。
        // 终态（取消/成功/失败/失效）快照归零。----
        .RequestReload -> {
            if !.reload_confirm_open {
                var i int = 0
                var found int = -1
                while i < .tabs.len() {
                    if .tabs[i].key == .active_key {
                        if .tabs[i].path == .active_path {
                            found = i
                        }
                    }
                    i = i + 1
                }
                if found >= 0 {
                    if .tabs[found].path == "" {
                        .save_note = "请先保存此文档（未命名），再重载"
                        console_log("reload: untitled rejected")
                    } else {
                        .reload_target_key = .tabs[found].key
                        .reload_target_path = .tabs[found].path
                        .reload_target_body = .tabs[found].body
                        .reload_target_doc = .tabs[found].doc_id
                        .reload_target_seq = .tabs[found].draft_seq
                        .reload_target_conf = .tabs[found].draft_conf
                        .reload_was_dirty = .tabs[found].dirty
                        if .tabs[found].dirty {
                            .reload_confirm_open = true
                        } else {
                            store.ReloadReadOf()
                        }
                    }
                } else {
                    console_log("reload: no active document")
                }
            }
            .console = console_lines()
        }

        // ---- 取消确认（弹层取消钮）：仅结请求——正文/原文基准/脏标/
        // 磁盘全保持。----
        .ReloadCancel -> {
            .reload_confirm_open = false
            .reload_target_key = ""
            .reload_target_path = ""
            .reload_target_body = ""
            .reload_target_doc = ""
            .reload_target_seq = 0
            .reload_target_conf = 0
            .reload_was_dirty = false
            console_log("reload: cancelled")
            .console = console_lines()
        }

        // ---- 明确放弃并重载（弹层放弃钮）：关确认 → 前置复核（目标仍
        // 为活动页且正文等于快照）→ 受保护读盘。复核不过不动正文。
        // ⚠ 门挂快照非开态旗标——vue 轨 AlertDialogAction 内部先关弹层
        // （DialogClose → v-model 写 flag=false）再派发 @click（T-04 开发
        // 期实勘），旗标门会恒 no-op；快照在关弹层写不触及，且闲触/
        // Escape 残置下 armed 门兜底。----
        .ReloadDiscard -> {
            if .reload_target_path != "" {
                .reload_confirm_open = false
                store.ReloadReadOf()
            }
            .console = console_lines()
        }

        // ---- 受保护读盘（RequestReload 干净直入 / ReloadDiscard 确认后
        // 共口）：读前+读后双复核（vue/split 臂 read_wiki await 悬窗内
        // Edit/TabActivate/CloseTab 照常派发——迟到结果不得覆盖新输入；
        // merged 臂同步完成，门共享同源）。缺档（exists 守卫）、读取异
        // 常（try/catch）均失败提示且不动正文/脏标；空文为合法读回。
        // ReloadReadOf 亦可被弹层族先例外的路径误触——无快照时 no-op。----
        .ReloadReadOf -> {
            var armed bool = .reload_target_path != ""
            if armed {
                if .active_key != .reload_target_key {
                    armed = false
                }
                if .active_path != .reload_target_path {
                    armed = false
                }
                if .active_body != .reload_target_body {
                    armed = false
                }
            }
            if armed {
                var proceed bool = true
                if !exists(.reload_target_path) {
                    .save_note = "重载失败：文件已不存在 " + .reload_target_path
                    console_log("reload: not-found " + .reload_target_path)
                    proceed = false
                }
                if proceed {
                    var body str = ""
                    var ok bool = true
                    try {
                        body = read_wiki(.reload_target_path)
                    } catch (e) {
                        ok = false
                    }
                    if ok {
                        var j int = 0
                        var hit int = -1
                        while j < .tabs.len() {
                            if .tabs[j].key == .reload_target_key {
                                if .tabs[j].path == .reload_target_path {
                                    hit = j
                                }
                            }
                            j = j + 1
                        }
                        var commit bool = false
                        var stale bool = false
                        if hit >= 0 {
                            if .tabs[hit].body == .reload_target_body {
                                if .active_key == .reload_target_key {
                                    commit = true
                                } else {
                                    stale = true
                                }
                            } else {
                                stale = true
                            }
                        } else {
                            stale = true
                        }
                        if stale {
                            .save_note = "文档已变化，请重新发起重载"
                            console_log("reload: stale-target rejected")
                        }
                        if commit {
                            // 放弃发起的结算门（T-05）：成功读回+目标匹配后
                            // 先结算被放弃草稿；**结算失败不提交正文替换**
                            //（磁盘未动，正文/脏标保持——用户可重发起）。
                            var settle_ok bool = true
                            if .reload_was_dirty {
                                if .reload_target_seq > 0 {
                                    var sr str = ""
                                    var sok bool = true
                                    try {
                                        sr = draft_settle(.reload_target_doc, .reload_target_seq, "discarded", "", .reload_target_conf)
                                    } catch (e5) {
                                        sok = false
                                    }
                                    if !sok {
                                        sr = "err:transport"
                                    }
                                    if sr != "ok" {
                                        settle_ok = false
                                        .save_note = "草稿结算失败——重载未执行（正文保持）"
                                        console_log("reload-settle-failed: " + .reload_target_doc + " " + sr)
                                    }
                                }
                            }
                            if settle_ok {
                                .tabs[hit].body = body
                                .tabs[hit].original_body = body
                                .tabs[hit].dirty = false
                                .reload_nonce = .reload_nonce + 1
                                .tabs[hit].key = .tabs[hit].path + "#r" + .reload_nonce.str()
                                .active_key = .tabs[hit].key
                                .active_body = body
                                .active_dirty = false
                                .save_note = "reloaded: " + .reload_target_path
                                console_log("reloaded: " + .reload_target_path)
                            }
                        }
                    } else {
                        .save_note = "重载失败：读取异常 " + .reload_target_path
                        console_log("reload: read-failed " + .reload_target_path)
                    }
                }
            } else {
                if .reload_target_path != "" {
                    .save_note = "文档已变化，请重新发起重载"
                    console_log("reload: stale-request rejected")
                }
            }
            .reload_target_key = ""
            .reload_target_path = ""
            .reload_target_body = ""
            .reload_target_doc = ""
            .reload_target_seq = 0
            .reload_target_conf = 0
            .reload_was_dirty = false
            .console = console_lines()
        }

        // ---- 关闭 tab：脏 tab 先确认（基座 Plan 420 P2 弹层） ----
        .RemoveAt(i) -> {
            .tabs.remove(i)
            .tab_count = .tabs.len()
            if .tab_count > 0 {
                if i == .tab {
                    if i >= .tab_count {
                        .tab = .tab_count - 1
                    }
                }
                if i < .tab {
                    .tab = .tab - 1
                }
                store.TabActivate(.tab)
            } else {
                .tab = -1
                .active_path = ""
                .active_key = ""
                .active_title = ""
                .active_body = ""
                .active_dirty = false
                .save_note = ""
            }
        }
        // ---- 关闭 tab（PLAN-031 T-05 快照化）：脏 tab 捕获身份+正文修订
        // 快照（key/path/body/doc——取代 confirm_idx 索引依赖：异步流程
        // 中列表变化索引过期，计划 §4.2）；干净 tab 直除。----
        .CloseTab(i) -> {
            if .tabs[i].dirty {
                .close_target_key = .tabs[i].key
                .close_target_path = .tabs[i].path
                .close_target_body = .tabs[i].body
                .close_target_doc = .tabs[i].doc_id
                .confirm_open = true
            } else {
                store.RemoveAt(i)
                console_log("closed tab; open=" + .tab_count.str())
            }
            .console = console_lines()
        }
        // ---- 放弃修改并关闭（弹层明确钮；门挂快照非旗标——F-30-R1 在册
        // 教训：AlertDialogAction 先关弹层再派发，旗标门恒 no-op）：身份
        // 重查 + 正文等于快照（无新输入）→ 结算 discarded（settle_erev=
        // 快照时确认修订；seq==0 = 从未保护过 → 无记录面如实移除）→ 结
        // 算成功才移除；结算失败/目标过期 → 不移除+提示（AC-07/09）。
        // ⚠ 取消不新增结算。----
        .ConfirmClose -> {
            if .close_target_key != "" {
                var f int = -1
                var i int = 0
                while i < .tabs.len() {
                    if .tabs[i].key == .close_target_key {
                        if .tabs[i].path == .close_target_path {
                            f = i
                        }
                    }
                    i = i + 1
                }
                if f >= 0 {
                    if .tabs[f].body == .close_target_body {
                        var doc str = .tabs[f].doc_id
                        var conf int = .tabs[f].draft_conf
                        var seqv int = .tabs[f].draft_seq
                        var ok bool = true
                        if seqv > 0 {
                            var r str = ""
                            var rok bool = true
                            try {
                                r = draft_settle(doc, seqv, "discarded", "", conf)
                            } catch (e3) {
                                rok = false
                            }
                            if !rok {
                                r = "err:transport"
                            }
                            if r != "ok" {
                                ok = false
                                .save_note = "草稿结算失败（已保留恢复记录）——未关闭"
                                console_log("close-discard-failed: " + doc + " " + r)
                            }
                        }
                        if ok {
                            store.RemoveAt(f)
                            console_log("closed dirty tab (discarded); open=" + .tab_count.str())
                        }
                    } else {
                        .save_note = "文档已变化，请重新关闭"
                        console_log("close: stale-target rejected")
                    }
                } else {
                    console_log("close: target gone")
                }
            }
            .confirm_open = false
            .close_target_key = ""
            .close_target_path = ""
            .close_target_body = ""
            .close_target_doc = ""
            .console = console_lines()
        }
        // ---- 保留草稿并关闭（弹层新钮；§5.4 表第二行）：等最新正文检查
        // 点成功（drain 单在-flight 循环——merged 同步收尾/vue 排水至收
        // 束）→ state==saved 且无更新输入（draft_erev==draft_conf）→ 仅
        // 移除该身份 tab（草稿记录保留——重启可恢复）；失败/新输入/目标
        // 过期 → 不移除+提示（AC-07）。----
        .ConfirmKeepClose -> {
            if .close_target_key != "" {
                var f int = -1
                var i int = 0
                while i < .tabs.len() {
                    if .tabs[i].key == .close_target_key {
                        if .tabs[i].path == .close_target_path {
                            f = i
                        }
                    }
                    i = i + 1
                }
                if f >= 0 {
                    if .tabs[f].body == .close_target_body {
                        var doc str = .tabs[f].doc_id
                        if doc == "" {
                            if .draft_epoch == 0 {
                                .draft_epoch = draft_begin().parse_int()
                            }
                            .tabs[f].doc_id = draft_alloc()
                            doc = .tabs[f].doc_id
                        }
                        if doc != "" {
                            store.DraftDrainOf(doc)
                            var g int = -1
                            var k int = 0
                            while k < .tabs.len() {
                                if .tabs[k].doc_id == doc {
                                    g = k
                                }
                                k = k + 1
                            }
                            if g >= 0 {
                                if .tabs[g].draft_state == "saved" {
                                    if .tabs[g].draft_erev == .tabs[g].draft_conf {
                                        store.RemoveAt(g)
                                        console_log("closed dirty tab (draft kept); open=" + .tab_count.str())
                                    } else {
                                        .save_note = "等待中出现新输入——未关闭（草稿继续保护）"
                                        console_log("close-keep: newer input rejected")
                                    }
                                } else {
                                    .save_note = "草稿检查点未确认——未关闭（正文保持）"
                                    console_log("close-keep: checkpoint not confirmed")
                                }
                            } else {
                                console_log("close-keep: target gone after drain")
                            }
                        } else {
                            .save_note = "草稿身份分配失败——未关闭"
                            console_log("close-keep: alloc failed")
                        }
                    } else {
                        .save_note = "文档已变化，请重新关闭"
                        console_log("close-keep: stale-target rejected")
                    }
                } else {
                    console_log("close-keep: target gone")
                }
            }
            .confirm_open = false
            .close_target_key = ""
            .close_target_path = ""
            .close_target_body = ""
            .close_target_doc = ""
            .console = console_lines()
        }
        .ConfirmCancel -> {
            .confirm_open = false
            .close_target_key = ""
            .close_target_path = ""
            .close_target_body = ""
            .close_target_doc = ""
        }

        // ---- 新建 untitled（key 兜底通道——编辑器 key 变即重挂载播种）。
        // 草稿身份惰性分配（首次脏编辑时 draft_alloc——T-03）----
        .ActNew -> {
            .open_count = .open_count + 1
            .tab_seq = .tab_seq + 1
            .tabs.push({
                key: "untitled-" + .open_count.str(),
                path: "",
                title: "未命名",
                body: "",
                original_body: "",
                dirty: false,
                doc_id: "",
                draft_erev: 0,
                draft_state: "",
                draft_seq: 0,
                draft_conf: 0,
                recover_src_doc: "",
                recover_src_seq: 0,
                recover_src_erev: 0,
                tab_uid: .tab_seq,
                lc_review: false,
            })
            .tab_count = .tabs.len()
            store.TabActivate(.tab_count - 1)
            console_log("new: untitled tab")
            .console = console_lines()
        }

        // ---- 打开（AUTO_OPEN_PATH 测试旁路 → dialog_open）→ Open 同口 ----
        .ActOpen -> {
            var p str = env_str("AUTO_OPEN_PATH")
            if p == "" {
                p = dialog_open(".ad, .md")
            }
            if p != "" {
                store.Open({ path: p })
            } else {
                console_log("open: cancelled")
            }
            .console = console_lines()
        }

        // ---- 编辑器操作族降级（autodown_editor 无 builtin 通道，T-00
        // 实勘登记；编辑器内原生快捷键仍可用） ----
        .ActUndo -> { console_log("editor-native: undo（autodown_editor 无 builtin）"); .console = console_lines() }
        .ActRedo -> { console_log("editor-native: redo"); .console = console_lines() }
        .ActCut -> { console_log("editor-native: cut"); .console = console_lines() }
        .ActCopy -> { console_log("editor-native: copy"); .console = console_lines() }
        .ActPaste -> { console_log("editor-native: paste"); .console = console_lines() }
        .ActSelectAll -> { console_log("editor-native: select-all"); .console = console_lines() }

        .ActConsole -> {
            .console_open = !.console_open
            .console = console_lines()
        }
        .ConsoleClear -> {
            console_clear()
            .console = ""
        }
        // 循环切 tab（基座两 tab 翻转语义推广为轮转；无 % 先例——显式分支）。
        .ActSwitchTab -> {
            if .tab_count > 1 {
                var nxt int = .tab + 1
                if nxt >= .tab_count {
                    nxt = 0
                }
                store.TabActivate(nxt)
            }
            .console = console_lines()
        }
        .ActAbout -> {
            console_log("jade-edit 0.1 — auto-edit 基座 + autodown_editor（PLAN-001 换基）")
            .console = console_lines()
        }

        // ---- 退出/关窗确认（PLAN-031 T-05）：脏 tab 存在 → 弹层；批量
        // 捕获 key 串行清单（身份定址——处理中逐项重查，不依赖索引）。
        // ----
        .CloseRequest -> {
            var any bool = false
            var keys str = ""
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].dirty {
                    any = true
                    if keys != "" {
                        keys = keys + "\u0001"
                    }
                    keys = keys + .tabs[i].key
                }
                i = i + 1
            }
            if any {
                .quit_keys = keys
                .quit_confirm_open = true
            } else {
                console_log("quit")
                Process.exit(0)
            }
            .console = console_lines()
        }
        .ActQuit -> { store.CloseRequest() }
        .QuitConfirmCancel -> {
            .quit_confirm_open = false
            .quit_keys = ""
        }
        // ---- 保留草稿并退出（§5.4 表第四行）：捕获所有脏文档（含后台
        // 和未命名）→ 逐个排水至最新确认 → 全部 saved 且无更新输入 →
        // VM 退出；任一失败/新输入 → 保持应用+提示（AC-07）。vue 轨
        // Process.exit no-op——验证处理结果态，真实退出由 vm 矩阵承载。
        // ----
        .QuitKeepClose -> {
            if .draft_epoch == 0 {
                .draft_epoch = draft_begin().parse_int()
            }
            var fail bool = false
            var ks = .quit_keys.split("\u0001")
            var i int = 0
            while i < ks.len() {
                var k str = ks[i]
                var f int = -1
                var j int = 0
                while j < .tabs.len() {
                    if .tabs[j].key == k {
                        f = j
                    }
                    j = j + 1
                }
                if f >= 0 {
                    var doc str = .tabs[f].doc_id
                    if doc == "" {
                        if .draft_epoch == 0 {
                            .draft_epoch = draft_begin().parse_int()
                        }
                        .tabs[f].doc_id = draft_alloc()
                        doc = .tabs[f].doc_id
                    }
                    if doc == "" {
                        fail = true
                        .save_note = "草稿身份分配失败——保持应用"
                        console_log("quit-keep: alloc failed " + k)
                    } else {
                        store.DraftDrainOf(doc)
                        var g int = -1
                        var m int = 0
                        while m < .tabs.len() {
                            if .tabs[m].doc_id == doc {
                                g = m
                            }
                            m = m + 1
                        }
                        if g < 0 {
                            fail = true
                            console_log("quit-keep: target gone " + doc)
                        } else {
                            if .tabs[g].draft_state != "saved" {
                                fail = true
                                .save_note = "草稿检查点未全部确认——保持应用"
                                console_log("quit-keep: not confirmed " + doc + " " + .tabs[g].draft_state)
                            } else {
                                if .tabs[g].draft_erev != .tabs[g].draft_conf {
                                    fail = true
                                    .save_note = "等待中出现新输入——保持应用"
                                    console_log("quit-keep: newer input " + doc)
                                }
                            }
                        }
                    }
                }
                i = i + 1
            }
            if !fail {
                console_log("quit: drafts kept & exit")
                Process.exit(0)
            }
            .quit_confirm_open = false
            .quit_keys = ""
            .console = console_lines()
        }
        // ---- 保存并退出（§5.4 表第五行）：有路径逐项保存+读回核验；
        // 未命名逐项 Save As（AUTO_SAVE_PATH 旁路首档适用——余档经
        // dialog_save，取消 = 空返 → 停止退出保持应用）；写失败/读回不
        // 一致 → 保持应用+如实标记（部分成功档如实已存——AC-08）。全部
        // 当前修订保存成功才 VM 退出。----
        .QuitSaveClose -> {
            var fail bool = false
            var ks = .quit_keys.split("\u0001")
            var i int = 0
            while i < ks.len() {
                var k str = ks[i]
                var f int = -1
                var j int = 0
                while j < .tabs.len() {
                    if .tabs[j].key == k {
                        f = j
                    }
                    j = j + 1
                }
                if f >= 0 {
                    if .tabs[f].lc_review {
                        if .tabs[f].path != "" {
                            // 待核验门（PLAN-032 T-03，AC-10）——保持应用
                            fail = true
                            .save_note = "存在待核验文档（" + .tabs[f].title + "）——保持应用，请先另存或核验"
                            console_log("quit-save: review blocked " + .tabs[f].path)
                            i = ks.len()
                        }
                    }
                }
                if !fail {
                if f >= 0 {
                    var body str = .tabs[f].body
                    if .tabs[f].path == "" {
                        var p str = ""
                        if i == 0 {
                            p = env_str("AUTO_SAVE_PATH")
                        }
                        if p == "" {
                            p = dialog_save("untitled.ad")
                        }
                        if p == "" {
                            fail = true
                            .save_note = "另存取消——保持应用"
                            console_log("quit-save: save-as cancelled " + k)
                            i = ks.len()
                        } else {
                            .tabs[f].path = p
                            .tabs[f].key = p
                            .tabs[f].title = strip_ad(p)
                            .tabs[f].lc_review = false
                        }
                    }
                    if !fail {
                        if .tabs[f].path != "" {
                            var saved bool = write_wiki(.tabs[f].path, body)
                            var okb bool = saved
                            if saved {
                                var back str = ""
                                try {
                                    back = read_wiki(.tabs[f].path)
                                } catch (e) {
                                    okb = false
                                }
                                if back != body {
                                    okb = false
                                }
                            }
                            if okb {
                                var seqv int = .tabs[f].draft_seq
                                var conf int = .tabs[f].draft_conf
                                var doc str = .tabs[f].doc_id
                                if seqv > 0 {
                                    try {
                                        draft_settle(doc, seqv, "saved", "", conf)
                                    } catch (e6) {
                                        console_log("quit-save: settle failed " + doc)
                                    }
                                }
                                .tabs[f].original_body = body
                                .tabs[f].dirty = .tabs[f].body != body
                                console_log("quit-save: saved " + .tabs[f].path)
                            } else {
                                fail = true
                                .save_note = "保存核验未通过——保持应用"
                                console_log("quit-save: verify failed " + .tabs[f].path)
                            }
                        }
                    }
                }
                }
                i = i + 1
            }
            if !fail {
                console_log("quit: saved & exit")
                Process.exit(0)
            }
            .quit_confirm_open = false
            .quit_keys = ""
            .console = console_lines()
        }
        // ---- 放弃修改并退出（§5.4 表第六行）：逐目标修订明确结算
        //（seq==0 = 从未保护过 → 无记录面如实记成功）；全部成功才 VM
        // 退出；任一失败 → 保持应用+提示（AC-09）。----
        .QuitDiscard -> {
            var fail bool = false
            var ks = .quit_keys.split("\u0001")
            var i int = 0
            while i < ks.len() {
                var k str = ks[i]
                var f int = -1
                var j int = 0
                while j < .tabs.len() {
                    if .tabs[j].key == k {
                        f = j
                    }
                    j = j + 1
                }
                if f >= 0 {
                    var doc str = .tabs[f].doc_id
                    var seqv int = .tabs[f].draft_seq
                    var conf int = .tabs[f].draft_conf
                    if seqv > 0 {
                        var r str = ""
                        var rok bool = true
                        try {
                            r = draft_settle(doc, seqv, "discarded", "", conf)
                        } catch (e7) {
                            rok = false
                        }
                        if !rok {
                            r = "err:transport"
                        }
                        if r != "ok" {
                            fail = true
                            .save_note = "草稿结算失败——保持应用"
                            console_log("quit-discard-failed: " + doc + " " + r)
                        }
                    }
                }
                i = i + 1
            }
            if !fail {
                console_log("quit: discard & exit")
                Process.exit(0)
            }
            .quit_confirm_open = false
            .quit_keys = ""
            .console = console_lines()
        }

        // 反链面板开关（PLAN-003；数据刷新/行派生在 App 侧 ActBacklinks）。
        .BacklinksToggle -> {
            .backlinks_open = !.backlinks_open
            .console = console_lines()
        }

        // 标签面板开关（PLAN-008；数据刷新/行派生在 App 侧 ActTags——
        // BacklinksToggle 同构第三实例）。
        .TagsToggle -> {
            .tags_open = !.tags_open
            .console = console_lines()
        }

        // ---- 查找面板（PLAN-004）：开态+模式双字段一口维护。FindOpen =
        // 幂等重开（已开则切模式——v1 聚焦语义从简）；FindClose = 快开
        // 拾取即关的 store 关口（开态权威单点——T-03 落定）。 ----
        .FindOpen(mode) -> {
            .find_open = true
            .find_mode = mode
            .console = console_lines()
        }
        .FindToggle -> {
            .find_open = !.find_open
            .console = console_lines()
        }
        .FindClose -> {
            .find_open = false
            .console = console_lines()
        }

        // ---- 悬空建页确认弹层（PLAN-005）：入口 = App .CreateClick
        //（悬空出链行 button）。Open 只置弹层态两字段；Cancel 只关弹层
        //——target 留置无害（下次 Open 覆写；弹层闭态不渲染）。----
        .CreateConfirmOpen(target) -> {
            .create_confirm_open = true
            .create_target = target
            .console = console_lines()
        }
        .CreateConfirmCancel -> {
            .create_confirm_open = false
            .console = console_lines()
        }

        // ---- 重命名弹层（PLAN-006）：Open/Close 只翻开态（入口守卫与
        // rename_q 预填在 App 侧 .RenameOpen——action enabled_if 同公式）。
        // Cancel = Close（取消零落盘——无 back 调用）。----
        .RenameOpen -> {
            .rename_open = true
            .console = console_lines()
        }
        .RenameClose -> {
            .rename_open = false
            .console = console_lines()
        }

        // ---- 新建/删除弹层（PLAN-007）：Open/Close 只翻开态（new_q
        // 置空在 App 侧 .ActNewFile；删除目标 = App .ft_sel，零新字段）。
        // Cancel = Close（取消零落盘——无 back 调用）。----
        .NewOpen -> {
            .new_open = true
            .console = console_lines()
        }
        .NewClose -> {
            .new_open = false
            .console = console_lines()
        }
        .DeleteOpen -> {
            .delete_open = true
            .console = console_lines()
        }
        .DeleteClose -> {
            .delete_open = false
            .console = console_lines()
        }

        // ---- 页面属性弹层（PLAN-011）：Open/Close 只翻开态（入口守卫
        // 与 meta_q 双预填在 App 侧 .ActMeta——action 不挂 enabled[D-24③
        // ——handler 守卫 untitled no-op]；取消零落盘——无 back 调用）。----
        .MetaOpen -> {
            .meta_open = true
            .console = console_lines()
        }
        .MetaClose -> {
            .meta_open = false
            .console = console_lines()
        }

        // ---- 新建/移动目录弹层（PLAN-012）：Open/Close 只翻开态（入口
        // 守卫与 move_q 预填在 App 侧 .ActMove；取消零落盘——无 back
        // 调用）。弹层面分野同 MetaOpen/MetaClose。----
        .DirOpen -> {
            .dir_open = true
            .console = console_lines()
        }
        .DirClose -> {
            .dir_open = false
            .console = console_lines()
        }
        .MoveOpen -> {
            .move_open = true
            .console = console_lines()
        }
        .MoveClose -> {
            .move_open = false
            .console = console_lines()
        }

        // ---- 删除/重命名目录弹层（PLAN-014）：Open/Close 只翻开态（目标
        // input 置空在 App 侧 .ActDelDir/.ActRenDir——弹层面分野同
        // MoveOpen/MoveClose；取消零落盘——无 back 调用）。----
        .DelDirOpen -> {
            .deldir_open = true
            .console = console_lines()
        }
        .DelDirClose -> {
            .deldir_open = false
            .console = console_lines()
        }
        .RenDirOpen -> {
            .rendir_open = true
            .console = console_lines()
        }
        .RenDirClose -> {
            .rendir_open = false
            .console = console_lines()
        }

        // ---- 移动目录弹层（PLAN-018）：Open/Close 只翻开态（双 input
        // 置空在 App 侧 .ActMoveDir——弹层面分野同 RenDirOpen/RenDirClose
        //；取消零落盘——无 back 调用）。----
        .MoveDirOpen -> {
            .movedir_open = true
            .console = console_lines()
        }
        .MoveDirClose -> {
            .movedir_open = false
            .console = console_lines()
        }

        // ---- 工作区规模警示（PLAN-021；App TreeRefresh 单写口——阈值
        // 判定在 App 侧，store 只承载显示态）：text 直写（"" = 清警示）。
        .WsWarn(text) -> {
            .ws_warn = text
        }

        // ---- 生命周期受检流（PLAN-032 T-03；契约 =
        // docs/plans/attachments/032-lifecycle-protocol.md §3/§4；架构 =
        // App 发起全部 fetch，store 只做同步策略机——verdict/basis/moves
        // 在 msg 派发后可被 App 同步读回，双轨成立）。----
        // 门判定：lp1 记录解析 → 受影响域（changes ∪ moves 两端 ∪
        // rewrites ∪ deletes 旧端——T-01 实证门匹配域）匹配全部打开实例
        // （不只活动页）；dirty/草稿在途/待核验 → 阻断弹层（hold 释放，
        // 用户处理后重新发起——重试必须重新分析）；清洁实例入快照 + 漂移
        // 探测候选（App 逐个 read_wiki 后 LcDrift 回填）；无候选 → 快照
        // 就绪 verdict=ok（App 读 .lc_basis 发起受检提交）。----
        .LcGate(record, kind, a, b, c) -> {
            var rec str = record
            var k0 str = kind
            var a0 str = a
            var b0 str = b
            var c0 str = c
            .lc_verdict = "reject"
            var segs = rec.split("|")
            if segs[0] == "LP1" {
                if segs[1] == "ok" {
                    if !.lc_hold {
                        .lc_hold = true
                        .lc_kind = k0
                        .lc_a = a0
                        .lc_b = b0
                        .lc_c = c0
                        .lc_basis = segs[2]
                        var aff List = []
                        if segs[3] != "" {
                            var chg = segs[3].split("*")
                            var ci int = 0
                            while ci < chg.len() {
                                var it str = chg[ci]
                                var fp = it.split(":")
                                if fp.len() > 1 {
                                    if !lc_list_has(aff, fp[0]) {
                                        aff.push(fp[0])
                                    }
                                }
                                ci = ci + 1
                            }
                        }
                        if segs[4] != "" {
                            var mvs = segs[4].split("*")
                            var mi int = 0
                            while mi < mvs.len() {
                                var pr str = mvs[mi]
                                var pp = pr.split(">")
                                if pp.len() == 2 {
                                    if !lc_list_has(aff, pp[0]) {
                                        aff.push(pp[0])
                                    }
                                    if !lc_list_has(aff, pp[1]) {
                                        aff.push(pp[1])
                                    }
                                }
                                mi = mi + 1
                            }
                        }
                        if segs[5] != "" {
                            var rws = segs[5].split("*")
                            var ri int = 0
                            while ri < rws.len() {
                                var rw str = rws[ri]
                                if rw != "" {
                                    if !lc_list_has(aff, rw) {
                                        aff.push(rw)
                                    }
                                }
                                ri = ri + 1
                            }
                        }
                        if segs[6] != "" {
                            var dls = segs[6].split("*")
                            var di int = 0
                            while di < dls.len() {
                                var pr2 str = dls[di]
                                var pp2 = pr2.split(">")
                                if pp2.len() >= 1 {
                                    if pp2[0] != "" {
                                        if !lc_list_has(aff, pp2[0]) {
                                            aff.push(pp2[0])
                                        }
                                    }
                                }
                                di = di + 1
                            }
                        }
                        // 匹配全部打开实例（脏/在途 → 阻断；清洁 → 快照+漂移候选）
                        var blocked str = ""
                        var cand str = ""
                        .lc_snap = []
                        var i int = 0
                        while i < .tabs.len() {
                            var tp str = .tabs[i].path
                            if tp != "" {
                                if lc_list_has(aff, tp) {
                                    var reason str = ""
                                    if .tabs[i].lc_review {
                                        reason = "待核验"
                                    }
                                    if reason == "" {
                                        if .tabs[i].dirty {
                                            reason = "未保存"
                                        }
                                    }
                                    if reason == "" {
                                        if .tabs[i].draft_state == "sending" {
                                            reason = "草稿检查点在途"
                                        }
                                        if .tabs[i].draft_state == "pending" {
                                            reason = "草稿检查点待续"
                                        }
                                        if .tabs[i].draft_state == "error" {
                                            reason = "草稿检查点异常"
                                        }
                                    }
                                    if reason != "" {
                                        if blocked != "" {
                                            blocked = blocked + "|"
                                        }
                                        blocked = blocked + .tabs[i].title + "\u0001" + tp + "\u0001" + reason
                                    } else {
                                        if cand != "" {
                                            cand = cand + "|"
                                        }
                                        cand = cand + tp
                                        .lc_snap.push({ uid: .tabs[i].tab_uid, path: .tabs[i].path, body: .tabs[i].body, orig: .tabs[i].original_body, doc: .tabs[i].doc_id })
                                    }
                                }
                            }
                            i = i + 1
                        }
                        if blocked != "" {
                            .lc_block_open = true
                            .lc_block_list = blocked
                            .lc_block_kind = .lc_kind
                            .lc_block_rows = lc_block_rows_of(blocked)
                            .lc_hold = false
                            .lc_verdict = "blocked"
                            console_log("lc-blocked: " + .lc_kind)
                        } else {
                            if cand != "" {
                                .lc_pending = cand
                                .lc_verdict = "drift"
                            } else {
                                .lc_verdict = "ok"
                            }
                        }
                    }
                }
            }
            if .lc_verdict == "reject" {
                .save_note = "文件操作被拒绝（源缺失/目标冲突/参数无效）"
                console_log("lc-reject: " + kind)
            }
            console_log("lc-gate: verdict=" + .lc_verdict + " pending=" + .lc_pending)
            .console = console_lines()
        }

        // ---- 漂移探测回填（App 对每个候选 read_wiki 后调用；清洁页基准
        // 与磁盘不同 → 阻断「先手动重载」；候选清空即门终判：有阻断出
        // 弹层 hold 释放，无阻断 verdict=ok 快照已就绪）----
        .LcDrift(path, diskbody) -> {
            var p0 str = path
            var db str = diskbody
            if .lc_verdict == "drift" {
                var f int = -1
                var j int = 0
                while j < .tabs.len() {
                    if .tabs[j].path == p0 {
                        f = j
                    }
                    j = j + 1
                }
                if f >= 0 {
                    if .tabs[f].original_body != db {
                        if .lc_block_list != "" {
                            .lc_block_list = .lc_block_list + "|"
                        }
                        .lc_block_list = .lc_block_list + .tabs[f].title + "\u0001" + p0 + "\u0001磁盘已变化——请先手动重载"
                    }
                }
                var keep List = []
                var parts = .lc_pending.split("|")
                var m int = 0
                while m < parts.len() {
                    var pp str = parts[m]
                    if pp != "" {
                        if pp != p0 {
                            keep.push(pp)
                        }
                    }
                    m = m + 1
                }
                .lc_pending = lc_join_pipe(keep)
                if .lc_pending == "" {
                    if .lc_block_list != "" {
                        .lc_block_open = true
                        .lc_block_kind = .lc_kind
                        .lc_block_rows = lc_block_rows_of(.lc_block_list)
                        .lc_hold = false
                        .lc_verdict = "blocked"
                        console_log("lc-blocked-drift: " + .lc_kind)
                    } else {
                        .lc_verdict = "ok"
                    }
                }
                console_log("lc-drift: back=" + p0 + " pending=" + .lc_pending + " verdict=" + .lc_verdict)
            }
            .console = console_lines()
        }

        // ---- 回执协调（App 受检提交返回后调用；"" = 未知结果）。ok|partial
        // → 逐快照实例定向协调（tab_uid 定址 + 正文仍匹配才同步——晚输入
        // 保留，AC-07/08）；stale 零变更提示重试；未知/畸形 → 全部受影响
        // 实例标待核验（AC-10——禁旧路径保存）。终态 hold 释放、参数归零、
        // 活动投影重算。----
        .LcResolve(receipt) -> {
            var rec str = receipt
            .lc_hold = false
            if .lc_kind != "" {
                if rec == "" {
                    store.LcMarkReview()
                    .save_note = "操作结果未知——相关文档已标记待核验（不可按原路径保存，可另存副本）"
                    console_log("lc-unknown: " + .lc_kind)
                } else {
                    var segs = rec.split("|")
                    if segs[0] != "RC1" {
                        store.LcMarkReview()
                        .save_note = "操作结果未知——相关文档已标记待核验（不可按原路径保存，可另存副本）"
                        console_log("lc-malformed: " + .lc_kind)
                    } else {
                        var status str = segs[1]
                        .lc_status = status
                        .lc_moves = segs[3]
                        if status == "stale" {
                            .save_note = "文件已变化——方案过期，请重新发起"
                            console_log("lc-stale: " + .lc_kind)
                        } else {
                            if status == "reject" {
                                .save_note = "文件操作被拒绝"
                                console_log("lc-reject2: " + .lc_kind)
                            } else {
                                var i int = 0
                                while i < .lc_snap.len() {
                                    store.LcCoordinate(i, segs[3], segs[4], segs[5])
                                    i = i + 1
                                }
                                if status == "partial" {
                                    .save_note = "部分完成（已完成项已同步）：" + segs[6]
                                    console_log("lc-partial: " + .lc_kind + " " + segs[6])
                                } else {
                                    .save_note = "已完成：" + .lc_kind
                                    console_log("lc-ok: " + .lc_kind)
                                }
                            }
                        }
                    }
                }
            }
            .lc_kind = ""
            .lc_a = ""
            .lc_b = ""
            .lc_c = ""
            .lc_basis = ""
            .lc_snap = []
            .lc_pending = ""
            .lc_verdict = "done"
            if .tab >= 0 {
                if .tab < .tabs.len() {
                    store.TabActivate(.tab)
                }
            }
            .console = console_lines()
        }

        // ---- 单实例定向协调（uid 定址；规则 = 附件 §4 表）：路径迁移跟随
        // 回执实际 old>new（tab_uid/doc_id/脏标保持，不全局 Reload）；改写
        // 域命中且正文仍匹配快照 → 读盘同步 body+original_body（key 播种
        // 重挂载）；等待期新输入 → 保留新正文标待核验（不重读不重设基准）；
        // 删除域命中且仍清洁 → 关闭该实例；有输入/判定失据 → 保留为需另存
        // 副本（path 空、title 标记、doc_id 保持）。----
        .LcCoordinate(i int, moves str, rews str, dels str) -> {
            var s = .lc_snap[i]
            var uid int = s.uid
            var f int = -1
            var j int = 0
            while j < .tabs.len() {
                if .tabs[j].tab_uid == uid {
                    f = j
                }
                j = j + 1
            }
            if f >= 0 {
                var moved bool = false
                if moves != "" {
                    var mvs = moves.split("*")
                    var k int = 0
                    while k < mvs.len() {
                        var pr str = mvs[k]
                        var pp = pr.split(">")
                        if pp.len() == 2 {
                            var po str = pp[0]
                            var pn str = pp[1]
                            if .tabs[f].path == po {
                                .tabs[f].path = pn
                                .tabs[f].key = pn
                                .tabs[f].title = strip_ad(pn)
                                moved = true
                            }
                        }
                        k = k + 1
                    }
                }
                if moved {
                    if .tabs[f].dirty {
                        // 路径上下文修订检查点（PLAN-032 T-05，AC-11）：迁移
                        // 后脏页以新路径续排检查点（同 doc_id 新 seq——031 协
                        // 议 path 逐记录在案）；忙态（sending）不重入——在途
                        // 排水循环回执后按最新状态自续（D-31 排水语义）。
                        if .tabs[f].doc_id != "" {
                            if .tabs[f].draft_state != "sending" {
                                store.DraftDrainOf(.tabs[f].doc_id)
                            }
                        }
                    }
                }
                if rews != "" {
                    if lc_field_has(rews, .tabs[f].path) {
                        if .tabs[f].body == s.body {
                            if .tabs[f].original_body == s.orig {
                                var nb str = ""
                                var nok bool = true
                                try {
                                    nb = read_wiki(.tabs[f].path)
                                } catch (e) {
                                    nok = false
                                }
                                if nok {
                                    .tabs[f].body = nb
                                    .tabs[f].original_body = nb
                                    .tabs[f].dirty = false
                                    .reload_nonce = .reload_nonce + 1
                                    .tabs[f].key = .tabs[f].path + "#lc" + .reload_nonce.str()
                                    console_log("lc-synced: " + .tabs[f].path)
                                } else {
                                    .tabs[f].lc_review = true
                                    .save_note = "协调读失败——文档标记待核验"
                                }
                            } else {
                                .tabs[f].lc_review = true
                            }
                        } else {
                            .tabs[f].lc_review = true
                            .save_note = "文档在操作等待期有新输入——磁盘正文已变化，请核对（可另存保留副本）"
                            console_log("lc-late-input: " + .tabs[f].path)
                        }
                    }
                }
                if dels != "" {
                    var hit bool = false
                    var dls = dels.split("*")
                    var m int = 0
                    while m < dls.len() {
                        var pr2 str = dls[m]
                        var pp2 = pr2.split(">")
                        if pp2.len() >= 1 {
                            if .tabs[f].path == pp2[0] {
                                hit = true
                            }
                        }
                        m = m + 1
                    }
                    if hit {
                        if .tabs[f].dirty {
                            .tabs[f].path = ""
                            .tabs[f].title = .tabs[f].title + "（原文件已删除）"
                            console_log("lc-kept-copy: " + s.path)
                        } else {
                            if .tabs[f].body == s.body {
                                if .tabs[f].original_body == s.orig {
                                    store.RemoveAt(f)
                                    console_log("lc-closed-clean: " + s.path)
                                } else {
                                    .tabs[f].path = ""
                                    .tabs[f].title = .tabs[f].title + "（原文件已删除）"
                                    .tabs[f].lc_review = true
                                }
                            } else {
                                .tabs[f].path = ""
                                .tabs[f].title = .tabs[f].title + "（原文件已删除）"
                                .tabs[f].lc_review = true
                            }
                        }
                    }
                }
            }
            .console = console_lines()
        }

        // ---- 未知结果标记（快照全部受影响实例 lc_review=true——禁旧路径
        // 保存，另存/核验出口保留）----
        .LcMarkReview -> {
            var i int = 0
            while i < .lc_snap.len() {
                var s = .lc_snap[i]
                var uid int = s.uid
                var j int = 0
                while j < .tabs.len() {
                    if .tabs[j].tab_uid == uid {
                        .tabs[j].lc_review = true
                    }
                    j = j + 1
                }
                i = i + 1
            }
        }

        // ---- 阻断弹层取消（零落盘零提交；用户处理文档后重新发起——重新
        // 分析，不沿用旧列表）----
        .LcBlockCancel -> {
            .lc_block_open = false
            .lc_block_list = ""
            .lc_block_kind = ""
            .lc_block_rows = []
            console_log("lc-cancelled")
            .console = console_lines()
        }

        // ---- 删除档 tab 全量关闭（PLAN-007 T-03；G2 tab 关闭面）：
        // while 扫描（D-11 禁 .find 闭包——split 形态硬崩），命中即
        // store.RemoveAt(i)（在册口：.tabs.remove(i) + 激活索引修正 +
        // tab_count 维护免费复用——补件② splice 守 vue 面在册）；**命中
        // 不增 i**——remove 后元素左移同位重查，未命中才 i+1（全删 =
        // 循环至 len 归零，空态案 RemoveAt 免费收口）。关闭数 console
        // 注记（弹层警示预览 = App 侧 tabs_impact_text 派生，执行期返
        // 值仅日志）。----
        .CloseTabsOf(path) -> {
            var closed int = 0
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].path == path {
                    store.RemoveAt(i)
                    closed = closed + 1
                } else {
                    i = i + 1
                }
            }
            console_log("closed tabs of " + path + ": " + closed.str())
            .console = console_lines()
        }

        // ---- tab 路径全量更新（PLAN-006 T-03；G1「激活/后台同名档全
        // 量」）：while 扫描（D-11：禁 .find 闭包——split 形态硬崩）path
        // == old 的档更新 path/title（=stem）/key（编辑器 key 变即重挂
        // 载播种——D-03 归一形态；激活索引不变=同 tab 保持激活）。激活
        // 投影同步（active_path/title/key）：Reload 显现链前置——back 改
        // 写后磁盘为新文，key 新 → 下一次渲染重挂载读 content: = Reload
        // 后的 active_body（改名流顺序：TabsRenamed → Reload，渲染滞后
        // 于 handler 完成故播种即新文——自链改写显现）。----
        .TabsRenamed(old_path, new_path) -> {
            var i int = 0
            while i < .tabs.len() {
                if .tabs[i].path == old_path {
                    .tabs[i].path = new_path
                    .tabs[i].key = new_path
                    .tabs[i].title = strip_ad(new_path)
                }
                i = i + 1
            }
            if .active_path == old_path {
                .active_path = new_path
                .active_key = new_path
                .active_title = strip_ad(new_path)
            }
            console_log("renamed: " + old_path + " -> " + new_path)
            .console = console_lines()
        }
    }
}
