// editor_store.at — EditorStore: tabs/脏标/保存流状态机（038/449 store
// 形态 + 013 `.store.*` 视图读——vue/vm 双轨合法的消费面）。
//
// 单源纪律：本文件是 editor_store 的唯一源，vm/vue 双轨同源消费——旧
// jade-garden 的 front/desktop 分裂（副本+sync 脚本）不在本仓重演。
//
// 架构（PLAN-081 T-06 实测定形，013-todo 先例）：**状态权威与显示投影
// 全在 store**（tabs + active_path + active_title/active_body/active_dirty
// + save_note）；App 视图经 `.store.*` 读（vue=响应式 ref 投影 / vm=合并
// 根状态），App handler 纯薄委托不回读 store 状态——合并根状态的裸读
// （`.tabs`/`.active_path`）只在 vm 轨成立，vue 发射为裸标识符（T-06
// vue-tsc 实证），App 侧投影镜像方案随之退役。
//
// VM 约束（auto-edit README「vm 组件边界」照执）：
//   - view 不能调 fn（模板只读字段——派生标量由 handler 就地重算进
//     active_* 投影）；
//   - msg 载荷单类型（多参走单 map：Open({path})）；
//   - typed List/数组声明纪律（裸 `var x = []` 在 VM 轨静默坏列表）；
//   - `.find(t => ...)` 索引狩猎在册（findIndex VM 静默失效，071 delta①；
//     store computed 的 .active_tab 在 vue 发射为未声明标识符——T-06
//     实证，computed 退役，handler 内联 find）。
//
// 保存语义（对齐 jade desktop T-04 实证）：POST 的 frontmatter 整体替换
// 落盘（服务端仅补 updated_at）——须回传读到的 frontmatter，否则丢。
// VM 轨硬约束（T-03 两轮实测）：JsonAny 经 VM 变量/Obj 字面量存取均损坏
// （对象 id 泄漏/<vmref>），故 Save 内现读现传（见 .Save 注记）。

use back.api: read_wiki, write_wiki

// ".ad" 后缀剥离（tab 标题 = path 末段去扩展，PLAN-079 标题语义收敛
// web 单源同款）——slice 守卫，无正则字面量（a2r-clean 惯例）。
fn strip_ad(path str) str {
    var n = path.length
    if n > 3 {
        var tail = path.slice(n - 3, n)
        if tail == ".ad" {
            return path.slice(0, n - 3)
        }
    }
    return path
}

store EditorStore {
    model {
        // Tab 对象（path/title/body/original_body/dirty）。
        var tabs Array<str> = []
        // str+"" 哨兵替代 ?str（跨状态对象读 624 后仍不安全，070 T-02
        // 裁定；"" 即无活动 tab）。
        var active_path str = ""
        // —— 显示投影（视图唯一读面 `.store.*`；handler 内就地重算）——
        var active_title str = ""
        var active_body str = ""
        var active_dirty bool = false
        // store 侧状态注记（saved/save-failed/read-failed/reloaded）。
        var save_note str = ""
    }

    // msg 载荷单类型（编译器约束）：Open 单 map、Edit 单 str。
    msg Msg { Open(map), Edit(str), Save, Reload }

    on {
        // Open({path})：激活已载 tab 或新读 → 投影重算。
        .Open(args) -> {
            var path = args.path
            var existing = .tabs.find(t => t.path == path)
            if existing == null {
                var doc = None
                try {
                    doc = read_wiki(path)
                } catch (e) {
                    doc = None
                }
                if doc != null {
                    .tabs.push({
                        path: path,
                        title: strip_ad(path),
                        body: doc.body,
                        original_body: doc.body,
                        dirty: false,
                    })
                }
            }
            var t = .tabs.find(t => t.path == path)
            if t != null {
                .active_path = path
                .active_title = t.title
                .active_body = t.body
                .active_dirty = t.dirty
            } else {
                .save_note = "read-failed: " + path
            }
        }

        // Edit(text)：INPUT_TEXT 单参全文回写（041 同约定，整文替换语义）
        // ——就地变更 + 脏标重算（回到 original 清脏标）+ 投影同步
        //（active_body 回写 = 编辑器 content: 绑定的外部 diff 臂）。
        .Edit(text) -> {
            var t = .tabs.find(t => t.path == .active_path)
            if t != null {
                if t.body != text {
                    t.body = text
                    t.dirty = t.body != t.original_body
                }
                .active_body = text
                .active_dirty = t.dirty
            }
        }

        // Save：frontmatter **现读现传**——Save 时重读磁盘文档，把
        // doc.frontmatter 直接传入 write_wiki（v0 UI 无 frontmatter 编辑面，
        // 磁盘现值即用户意图值）。原因：JsonAny 经 VM 变量/Obj 字面量存取
        // 均损坏（T-03 两轮实测：Obj 字面量字段读回=对象 id 泄漏落盘
        // "4000090"；map 字段赋值=<vmref>→[]），读→传不落变量即绕开。
        // 成功清脏标 + original_body 前移 + 投影重算。
        .Save -> {
            var t = .tabs.find(t => t.path == .active_path)
            if t != null {
                var doc = None
                try {
                    doc = read_wiki(t.path)
                } catch (e) {
                    doc = None
                }
                if doc != null {
                    try {
                        var saved = write_wiki(t.path, doc.frontmatter, t.body)
                        var echo = saved.body
                        if echo == t.body {
                            t.dirty = false
                            t.original_body = t.body
                        }
                        .save_note = "saved: " + t.path
                    } catch (e) {
                        .save_note = "save-failed: " + t.path
                    }
                } else {
                    .save_note = "save-failed-readback: " + t.path
                }
                .active_dirty = t.dirty
            }
        }

        // Reload：强制重读激活 tab（六检查"保存落盘 → 重载可见"通道）
        // + 投影重算。
        .Reload -> {
            var t = .tabs.find(t => t.path == .active_path)
            if t != null {
                var doc = None
                try {
                    doc = read_wiki(t.path)
                } catch (e) {
                    doc = None
                }
                if doc != null {
                    t.body = doc.body
                    t.original_body = doc.body
                    t.dirty = false
                    .active_body = doc.body
                    .active_dirty = false
                    .save_note = "reloaded: " + t.path
                }
            }
        }
    }
}
