// back/wsys.at — wiki 工作区后端实现本体（PLAN-001 T-02）。
//
// 全部文件系统 IO 收口于此（front 零 fs.*/File.* 内建——vue 轨 ts_adapter
// 将二者拦为 __vmOnly 抛错桩，auto-edit PLAN-003 T-00 P-5 实证）。AutoVM
// 解释服役（merged 进程内 / split 为 HTTP 服务侧模块 / vue 轨供 HTTP）。
// 函数名与 api.at 契约名刻意错开（root_dir↔ws_root 等）——013-todo 形态：
// 契约 fn 与实现 fn 同名会在导入处遮蔽冲突。
//
// frontmatter 处理纯字符串层（split/concat），不经 JsonAny——VM JsonAny
// 损坏类（PLAN-081 T-03 两轮实测）结构性消除。行分隔按 "\n" 切；CRLF
// 文件行尾带 "\r"，界符判定按 "---" 与 "---\r" 双形态容错。

/// 工作区根：JADE_WORKSPACE（fixture 隔离通道——automan 无条件覆盖
/// AUTO_PROJECT_DIR，隔离只能走独立名）→ AUTO_PROJECT_DIR → "."
pub fn root_dir() str {
    var root str = Env.get("JADE_WORKSPACE")
    if root == "" {
        root = Env.get("AUTO_PROJECT_DIR")
    }
    if root == "" {
        root = "."
    }
    return root
}

/// 路径归一：相对路径（树行 id 等）拼工作区根；绝对路径（盘符/根斜杠）
/// 直通。VM 渲染期进程 CWD 会切到 src/front（automan 注记），相对路径
/// 绝不能裸用。
fn resolve(path str) str {
    if path == "" {
        return root_dir()
    }
    var n = path.length
    if n > 1 {
        if path.slice(1, 2) == ":" {
            return path
        }
    }
    var head = path.slice(0, 1)
    if head == "/" {
        return path
    }
    if head == "\\" {
        return path
    }
    return root_dir() + "/" + path
}

/// 目录树 JSON（front 侧 json.to_value 解析；该内建 vue 转译吸收）
pub fn tree_json(path str, depth int) str {
    return fs.tree(resolve(path), depth)
}

/// frontmatter 界符行判定（"---" 或 CRLF 尾 "---\r"）
fn is_delim(line str) bool {
    if line == "---" {
        return true
    }
    if line == "---\r" {
        return true
    }
    return false
}

/// 读文档 body：首行 = 界符 → 定位闭合界符行，其后原文直通；无
/// frontmatter → 全文直通。
///
/// 实现注记（PLAN-002 执行期勘误，O(n) 化）：旧实现 split 后逐行
/// `out = out + lines[j]` 重接——VM 字符串 `+` 每次全量 clone + 内容
/// 去重哈希，1MB/4 万行 ≈ 8 万次 ADD ≈ 78s+ 阻塞（C-5 首个实证）。
/// 现改为 split_once 标记法：闭合界符行（行恰为 "---"/"---\r"）的字节
/// 等价标记 = "\n---\n" / "\n---\r\n"（\n 后紧跟 --- 再跟行尾 ⟺ 行恰为
/// 界符），两标记首现者取其 after——split→join 同分隔符恒等原串，故
/// after 即旧「行重接」语义逐字节等价（含尾随换行保留）；两标记字节
/// 互斥（--- 后一位 \n vs \r），before 前缀单调保证首现比较与
/// .length 计数语义无关。VM 无 str.join 内建，此法为唯一 O(n) 通道。
pub fn read_body(path str) str {
    var text str = File.read_text(resolve(path))
    if text.starts_with("---\n") {
        return body_after_open(text)
    }
    if text.starts_with("---\r\n") {
        return body_after_open(text)
    }
    return text
}

/// 首行已确认为界符后的 body 提取（read_body 专用）。
fn body_after_open(text str) str {
    var p1 = text.split_once("\n---\n")
    var p2 = text.split_once("\n---\r\n")
    var has1 bool = p1.len() == 2
    var has2 bool = p2.len() == 2
    if !has1 {
        if !has2 {
            // 无闭合界符行：末行恰为界符（EOF 无尾换行形态）→ body 空；
            // 否则旧语义全文直通。
            if text.ends_with("\n---") {
                return ""
            }
            if text.ends_with("\n---\r") {
                return ""
            }
            return text
        }
        return p2[1]
    }
    if !has2 {
        return p1[1]
    }
    // 两标记并在：before 短者先现（同为 text 前缀，含前缀单调性）
    if p1[0].length <= p2[0].length {
        return p1[1]
    }
    return p2[1]
}

/// 写文档：存在且有 frontmatter → 界符段原文保留（含界符行与段尾换行）
/// + 新 body；否则（新文件/无 frontmatter）直写 body。落盘 exists 复核。
pub fn write_body(path str, body str) bool {
    var full str = resolve(path)
    var text str = ""
    var has bool = false
    if File.exists(full) {
        text = File.read_text(full)
        var lines = text.split("\n")
        if lines.len() > 0 {
            if is_delim(lines[0]) {
                var i int = 1
                while i < lines.len() {
                    if is_delim(lines[i]) {
                        has = true
                    }
                    i = i + 1
                }
            }
        }
    }
    var out str = ""
    if has {
        // 界符段 = 界符行起至闭合界符行（含，含段尾换行）逐行重接——与
        // read_body 的切分点互补，round-trip 字节稳定（body 未编辑时）。
        var lines2 = text.split("\n")
        var k int = 1
        var done bool = false
        while k < lines2.len() {
            if !done {
                out = out + lines2[k - 1] + "\n"
                if is_delim(lines2[k]) {
                    out = out + lines2[k] + "\n"
                    done = true
                }
            }
            k = k + 1
        }
    }
    out = out + body
    File.write_text(full, out)
    return File.exists(full)
}

/// 路径存在性
pub fn path_exists(path str) bool {
    return File.exists(resolve(path))
}

/// 环境变量读（未设 = ""）
pub fn env_lookup(name str) str {
    return Env.get(name)
}

// ===== 工作区链接索引（PLAN-003 T-02；知识库首切片 back 半） =====

/// JSON 字符串字面量转义（先 \\ 后 \"——次序颠倒会产生假转义；换行不出
/// 现在被转义串内：链接候选提取时已切、rel 为 OS 路径段）。手工装配
/// 纪律：全程 str，零 JsonAny（C-1 同 tree 先例）。
fn json_esc(s str) str {
    var r str = s.replace("\\", "\\\\")
    r = r.replace("\"", "\\\"")
    return r
}

/// stem 集内解析 target → rel（首现命中——同名 stem 冲突 v1 取首现，
/// walk 序，§10 默认裁定）；未命中 = ""。
fn stem_resolve(stems List, rels List, target str) str {
    var hit str = ""
    var i int = 0
    while i < stems.len() {
        if hit == "" {
            if stems[i] == target {
                hit = rels[i]
            }
        }
        i = i + 1
    }
    return hit
}

/// body 内 [[Target]] / [[Target#anchor]] 标记法提取（read_body 根修同
/// 族的 split/split_once 标记法——AutoVM 无正则面，VM 无 str.join 故
/// 此为已证 O(n) 通道族）→ link 对象 JSON 数组（逗号前置连接）。忽略
/// 面：无闭合 ]]（不完整对）/ 候选含换行（跨行链接 v1 不做，语料无此
/// 形态）/ trim 后空候选（旧园 links_gen 空标题同忽略）/ # 后空 target。
/// # 首现拆分：前段 target 参与 stem 匹配，后段 anchor 透传（D-12：无
/// 定位事件面，仅显示）。exists 判定 = stem_resolve 命中。
/// ⚠ VM 纪律（T-02 实勘）：列表元素上的链式方法调用错乱（heap 接收者
/// CALL_SPEC 错位——`segs[i].split_once(..)` 返回垃圾长度），元素必须
/// 先拷局部变量再调方法（links_json 节点收集循环同款已证形态）。
fn extract_links_json(body str, stems List, rels List) str {
    var out str = ""
    var segs = body.split("[[")
    var i int = 1
    while i < segs.len() {
        var seg str = segs[i]
        var pair = seg.split_once("]]")
        if pair.len() == 2 {
            var cand str = pair[0]
            var nl = cand.split("\n")
            if nl.len() < 2 {
                var trimmed str = cand.trim()
                if trimmed.length > 0 {
                    var target str = trimmed
                    var anchor str = ""
                    var hp = trimmed.split_once("#")
                    if hp.len() == 2 {
                        var t0 str = hp[0]
                        var a0 str = hp[1]
                        target = t0
                        anchor = a0
                    }
                    if target.length > 0 {
                        var tp str = stem_resolve(stems, rels, target)
                        if out != "" {
                            out = out + ","
                        }
                        out = out + "{\"target\":\"" + json_esc(target) + "\",\"anchor\":\"" + json_esc(anchor)
                        out = out + "\",\"exists\":"
                        if tp != "" {
                            out = out + "true,\"target_path\":\"" + json_esc(tp) + "\"}"
                        } else {
                            out = out + "false,\"target_path\":\"\"}"
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}

/// 工作区链接索引 JSON：{"pages":[{"path","title","links":[…]}]}。
/// path = 工作区根相对路径（/ 分隔——fs.tree id 同 convention，store.Open
/// 直吃）；title = 文件 stem（旧园 links.rs rebuild 同语义：title =
/// file_stem，非 frontmatter title——[[首页]] 对 index.ad = 悬空）；
/// links = 出链对象 {target,anchor,exists,target_path}。
/// 三步：①walk = fs.tree 同源遍历（本切片实测：fs.walk_files 原语在册
/// 未接 .at 调用面——Undefined symbol，2026-09-22 探针实证——故走已证
/// fs.tree：depth 语义直通（1..8 钳制同 tree），遍历序 = dirs-first +
/// 名称 casefold 序（确定性，首锁友好），忽略面 = tree 同款（.git/
/// target/build/node_modules/gen/dist/__pycache__/点开头——索引覆盖 =
/// 文件树覆盖，所见即所索引）②逐档 read_body 后 extract_links_json
/// 标记法提取 ③stem 解析装配。节点收集 = 树 JSON 段标记法：split
/// `{"id":` 每段一节点，file 节点 = 叶子（children:[] 空）故自身
/// `"kind":"file"` 落本段内；dir 段只含头 + 空 children 开括号（子节点
/// 各起新段）不误收。id 本为 `/` 分隔相对路径免剥前缀。装配逐页 `+`
/// 重接：v0 规模 O(P²) 前缀复制可接受（对照 read_body 78s 案 ≈ 8 万次
/// ADD；此处 P ≤ 数百），规模上量随检索批换 StringBuilder（native 160
/// 族）。
pub fn links_json(path str, depth int) str {
    var tree str = fs.tree(resolve(path), depth)
    var stems List = []
    var rels List = []
    var segs = tree.split("{\"id\":")
    var i int = 1
    while i < segs.len() {
        var seg str = segs[i]
        if seg.contains("\"kind\":\"file\"") {
            var head = seg.split_once(",\"label\":")
            if head.len() == 2 {
                // 带引号壳 id（"…"）——split 法去壳，不用 length+slice
                //（CJK heap 串 .length 字节语义会错位——T-02 实勘）。
                var idq str = head[0]
                var qparts = idq.split("\"")
                if qparts.len() >= 2 {
                    var rel str = qparts[1]
                    if rel.ends_with(".ad") {
                        // stem = 末段去 .ad 尾（split 法；文件名内嵌 ".ad"
                        // 的病理形态 v1 不支持——语料与常规命名不含）
                        var fsegs = rel.split("/")
                        var fname str = fsegs[fsegs.len() - 1]
                        var astrips = fname.split(".ad")
                        var stem str = astrips[0]
                        stems.push(stem)
                        rels.push(rel)
                    }
                }
            }
        }
        i = i + 1
    }
    var pages str = ""
    var j int = 0
    while j < rels.len() {
        var body str = read_body(rels[j])
        var links str = extract_links_json(body, stems, rels)
        if pages != "" {
            pages = pages + ","
        }
        pages = pages + "{\"path\":\"" + json_esc(rels[j]) + "\",\"title\":\"" + json_esc(stems[j])
        pages = pages + "\",\"links\":[" + links + "]}"
        j = j + 1
    }
    return "{\"pages\":[" + pages + "]}"
}
