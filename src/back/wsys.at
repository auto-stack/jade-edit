// back/wsys.at — wiki 工作区后端实现本体（PLAN-001 T-02）。
//
// 全部文件系统 IO 收口于此（front 零 fs.*/File.* 内建——vue 轨 ts_adapter
// 将二者拦为 __vmOnly 抛错桩，auto-edit PLAN-003 T-00 P-5 实证）。AutoVM
// 解释服役（merged 进程内 / split 为 HTTP 服务侧模块 / vue 轨供 HTTP）。
// 函数名与 api.at 契约名刻意错开（root_dir↔ws_root 等）——013-todo 形态：
// 契约 fn 与实现 fn 同名会在导入处遮蔽冲突。
//
// frontmatter 处理纯字符串层（split/concat），不经 JsonAny——VM JsonAny
// 损坏类（PLAN-081 T-03 两轮实测）结构性消除。行分隔按 "\n" 切；CRLF
// 文件行尾带 "\r"，界符判定按 "---" 与 "---\r" 双形态容错。

/// 工作区根：JADE_WORKSPACE（fixture 隔离通道——automan 无条件覆盖
/// AUTO_PROJECT_DIR，隔离只能走独立名）→ AUTO_PROJECT_DIR → "."
pub fn root_dir() str {
    var root str = Env.get("JADE_WORKSPACE")
    if root == "" {
        root = Env.get("AUTO_PROJECT_DIR")
    }
    if root == "" {
        root = "."
    }
    return root
}

/// 路径归一：相对路径（树行 id 等）拼工作区根；绝对路径（盘符/根斜杠）
/// 直通。VM 渲染期进程 CWD 会切到 src/front（automan 注记），相对路径
/// 绝不能裸用。
fn resolve(path str) str {
    if path == "" {
        return root_dir()
    }
    var n = path.length
    if n > 1 {
        if path.slice(1, 2) == ":" {
            return path
        }
    }
    var head = path.slice(0, 1)
    if head == "/" {
        return path
    }
    if head == "\\" {
        return path
    }
    return root_dir() + "/" + path
}

/// 目录树 JSON（front 侧 json.to_value 解析；该内建 vue 转译吸收）
pub fn tree_json(path str, depth int) str {
    return fs.tree(resolve(path), depth)
}

/// frontmatter 界符行判定（"---" 或 CRLF 尾 "---\r"）
fn is_delim(line str) bool {
    if line == "---" {
        return true
    }
    if line == "---\r" {
        return true
    }
    return false
}

/// 读文档 body：首行 = 界符 → 定位闭合界符行，其后原文直通；无
/// frontmatter → 全文直通。
///
/// 实现注记（PLAN-002 执行期勘误，O(n) 化）：旧实现 split 后逐行
/// `out = out + lines[j]` 重接——VM 字符串 `+` 每次全量 clone + 内容
/// 去重哈希，1MB/4 万行 ≈ 8 万次 ADD ≈ 78s+ 阻塞（C-5 首个实证）。
/// 现改为 split_once 标记法：闭合界符行（行恰为 "---"/"---\r"）的字节
/// 等价标记 = "\n---\n" / "\n---\r\n"（\n 后紧跟 --- 再跟行尾 ⟺ 行恰为
/// 界符），两标记首现者取其 after——split→join 同分隔符恒等原串，故
/// after 即旧「行重接」语义逐字节等价（含尾随换行保留）；两标记字节
/// 互斥（--- 后一位 \n vs \r），before 前缀单调保证首现比较与
/// .length 计数语义无关。VM 无 str.join 内建，此法为唯一 O(n) 通道。
pub fn read_body(path str) str {
    var text str = File.read_text(resolve(path))
    if text.starts_with("---\n") {
        return body_after_open(text)
    }
    if text.starts_with("---\r\n") {
        return body_after_open(text)
    }
    return text
}

/// 首行已确认为界符后的 body 提取（read_body 专用）。
fn body_after_open(text str) str {
    var p1 = text.split_once("\n---\n")
    var p2 = text.split_once("\n---\r\n")
    var has1 bool = p1.len() == 2
    var has2 bool = p2.len() == 2
    if !has1 {
        if !has2 {
            // 无闭合界符行：末行恰为界符（EOF 无尾换行形态）→ body 空；
            // 否则旧语义全文直通。
            if text.ends_with("\n---") {
                return ""
            }
            if text.ends_with("\n---\r") {
                return ""
            }
            return text
        }
        return p2[1]
    }
    if !has2 {
        return p1[1]
    }
    // 两标记并在：before 短者先现（同为 text 前缀，含前缀单调性）
    if p1[0].length <= p2[0].length {
        return p1[1]
    }
    return p2[1]
}

/// 写文档：存在且有 frontmatter → 界符段原文保留（含界符行与段尾换行）
/// + 新 body；否则（新文件/无 frontmatter）直写 body。落盘 exists 复核。
pub fn write_body(path str, body str) bool {
    var full str = resolve(path)
    var text str = ""
    var has bool = false
    if File.exists(full) {
        text = File.read_text(full)
        var lines = text.split("\n")
        if lines.len() > 0 {
            if is_delim(lines[0]) {
                var i int = 1
                while i < lines.len() {
                    if is_delim(lines[i]) {
                        has = true
                    }
                    i = i + 1
                }
            }
        }
    }
    var out str = ""
    if has {
        // 界符段 = 界符行起至闭合界符行（含，含段尾换行）逐行重接——与
        // read_body 的切分点互补，round-trip 字节稳定（body 未编辑时）。
        var lines2 = text.split("\n")
        var k int = 1
        var done bool = false
        while k < lines2.len() {
            if !done {
                out = out + lines2[k - 1] + "\n"
                if is_delim(lines2[k]) {
                    out = out + lines2[k] + "\n"
                    done = true
                }
            }
            k = k + 1
        }
    }
    out = out + body
    File.write_text(full, out)
    return File.exists(full)
}

/// 路径存在性
pub fn path_exists(path str) bool {
    return File.exists(resolve(path))
}

/// 环境变量读（未设 = ""）
pub fn env_lookup(name str) str {
    return Env.get(name)
}

// ===== 工作区链接索引（PLAN-003 T-02；知识库首切片 back 半） =====

/// JSON 字符串字面量转义（先 \\ 后 \"——次序颠倒会产生假转义；换行不出
/// 现在被转义串内：链接候选提取时已切、rel 为 OS 路径段）。手工装配
/// 纪律：全程 str，零 JsonAny（C-1 同 tree 先例）。
fn json_esc(s str) str {
    var r str = s.replace("\\", "\\\\")
    r = r.replace("\"", "\\\"")
    return r
}

/// stem 集内解析 target → rel（首现命中——同名 stem 冲突 v1 取首现，
/// walk 序，§10 默认裁定）；未命中 = ""。
fn stem_resolve(stems List, rels List, target str) str {
    var hit str = ""
    var i int = 0
    while i < stems.len() {
        if hit == "" {
            if stems[i] == target {
                hit = rels[i]
            }
        }
        i = i + 1
    }
    return hit
}

/// body 内 [[Target]] / [[Target#anchor]] 标记法提取（read_body 根修同
/// 族的 split/split_once 标记法——AutoVM 无正则面，VM 无 str.join 故
/// 此为已证 O(n) 通道族）→ link 对象 JSON 数组（逗号前置连接）。忽略
/// 面：无闭合 ]]（不完整对）/ 候选含换行（跨行链接 v1 不做，语料无此
/// 形态）/ trim 后空候选（旧园 links_gen 空标题同忽略）/ # 后空 target。
/// # 首现拆分：前段 target 参与 stem 匹配，后段 anchor 透传（D-12：无
/// 定位事件面，仅显示）。exists 判定 = stem_resolve 命中。
/// ⚠ VM 纪律（T-02 实勘）：列表元素上的链式方法调用错乱（heap 接收者
/// CALL_SPEC 错位——`segs[i].split_once(..)` 返回垃圾长度），元素必须
/// 先拷局部变量再调方法（links_json 节点收集循环同款已证形态）。
fn extract_links_json(body str, stems List, rels List) str {
    var out str = ""
    var segs = body.split("[[")
    var i int = 1
    while i < segs.len() {
        var seg str = segs[i]
        var pair = seg.split_once("]]")
        if pair.len() == 2 {
            var cand str = pair[0]
            var nl = cand.split("\n")
            if nl.len() < 2 {
                var trimmed str = cand.trim()
                if trimmed.length > 0 {
                    var target str = trimmed
                    var anchor str = ""
                    var hp = trimmed.split_once("#")
                    if hp.len() == 2 {
                        var t0 str = hp[0]
                        var a0 str = hp[1]
                        target = t0
                        anchor = a0
                    }
                    if target.length > 0 {
                        var tp str = stem_resolve(stems, rels, target)
                        if out != "" {
                            out = out + ","
                        }
                        out = out + "{\"target\":\"" + json_esc(target) + "\",\"anchor\":\"" + json_esc(anchor)
                        out = out + "\",\"exists\":"
                        if tp != "" {
                            out = out + "true,\"target_path\":\"" + json_esc(tp) + "\"}"
                        } else {
                            out = out + "false,\"target_path\":\"\"}"
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return out
}

/// 文件树 .ad 页面收集（links_json / search_json 共享——PLAN-004 T-01
/// 自 links_json 提取；覆盖 = 文件树不变式单点：忽略面/depth 钳制/walk 序
/// 同源维护）。返回 List，元素 = {stem, rel} map（消费面先拷局部变量再取
/// 字段——D-20② 纪律）。收集法 = 树 JSON 段标记法（split `{"id":` 每段一
/// 节点，file 节点 = 叶子故自身 `"kind":"file"` 落本段内；dir 段只含头 +
/// 空 children 开括号不误收）；id 本为 `/` 分隔相对路径免剥前缀。带引号
/// 壳 id 用 split 法去壳（不用 length+slice——CJK heap 串 .length 字节
/// 语义会错位，T-02 实勘）。stem = 末段去 .ad 尾（split 法；文件名内嵌
/// ".ad" 的病理形态 v1 不支持——语料与常规命名不含）。遍历序 = fs.tree
/// 同源（dirs-first + 名称 casefold，确定性，首锁友好）；depth 语义直通
///（1..8 钳制同 tree；fs.walk_files 原语在册未接 .at 调用面——D-20①，
/// 故走已证 fs.tree）。
pub fn collect_ad_pages(path str, depth int) List {
    var tree str = fs.tree(resolve(path), depth)
    var pages List = []
    var segs = tree.split("{\"id\":")
    var i int = 1
    while i < segs.len() {
        var seg str = segs[i]
        if seg.contains("\"kind\":\"file\"") {
            var head = seg.split_once(",\"label\":")
            if head.len() == 2 {
                var idq str = head[0]
                var qparts = idq.split("\"")
                if qparts.len() >= 2 {
                    var rel str = qparts[1]
                    if rel.ends_with(".ad") {
                        var fsegs = rel.split("/")
                        var fname str = fsegs[fsegs.len() - 1]
                        var astrips = fname.split(".ad")
                        var stem str = astrips[0]
                        pages.push({ stem: stem, rel: rel })
                    }
                }
            }
        }
        i = i + 1
    }
    return pages
}

/// 工作区链接索引 JSON：页面数组 [{"path","title","links":[…]},…]。
/// ⚠ 顶层形状 = 裸数组（无 {"pages":…} 包壳）：front json.to_value 消费
/// 面只对顶层 array 产物健康（App ft_nodes 同款已证；顶层 map 产物入态
/// = 裸 vmref 损坏，C-1 家族——T-04 实勘立案）。path = 工作区根相对路径
///（/ 分隔——fs.tree id 同 convention，store.Open 直吃）；title = 文件
/// stem（旧园 links.rs rebuild 同语义：title = file_stem，非 frontmatter
/// title——[[首页]] 对 index.ad = 悬空）；links = 出链对象
/// {target,anchor,exists,target_path}。
/// 三步：①walk = collect_ad_pages（本切片 T-01 提取共享——链接/检索两面
/// 覆盖一致）②逐档 read_body 后 extract_links_json 标记法提取 ③stem 解析
/// 装配。装配逐页 `+` 重接：v0 规模 O(P²) 前缀复制可接受（对照 read_body
/// 78s 案 ≈ 8 万次 ADD；此处 P ≤ 数百），规模上量随检索批换 StringBuilder
///（native 160 族）。
pub fn links_json(path str, depth int) str {
    var pages List = collect_ad_pages(path, depth)
    var stems List = []
    var rels List = []
    var i int = 0
    while i < pages.len() {
        var p = pages[i]
        stems.push(p.stem)
        rels.push(p.rel)
        i = i + 1
    }
    var pages_out str = ""
    var j int = 0
    while j < rels.len() {
        var body str = read_body(rels[j])
        var links str = extract_links_json(body, stems, rels)
        if pages_out != "" {
            pages_out = pages_out + ","
        }
        pages_out = pages_out + "{\"path\":\"" + json_esc(rels[j]) + "\",\"title\":\"" + json_esc(stems[j])
        pages_out = pages_out + "\",\"links\":[" + links + "]}"
        j = j + 1
    }
    return "[" + pages_out + "]"
}

/// 工作区全文检索 JSON：命中数组 [{"path","title","snippet"},…]
///（PLAN-004 T-01；知识库第二切片 back 半，移植自冻结池 jade-garden
/// search.rs Page 面线性化——v1 = 线性扫描，块级/倒排不迁）。
/// ⚠ 顶层裸数组（links_json 同裁定——front json.to_value 消费面）。
/// 匹配语义（SD-401）：query trim 空守卫 → []；命中 = stem 含 q 或 body
///（read_body，frontmatter 剥离面）含 q；大小写 = 两侧 to_lower（探针 A
/// 定谳：vue 发射在册——ts_adapter.rs:1610 `to_lower→toLowerCase`，T-02
/// 构建期 gen 树源检复核）；命中序 = collect_ad_pages walk 序（确定性）；
/// limit 钳 1..50（front 传 20 = 旧园 default_limit 同值）；walk depth = 4
/// 内部常量（Init tree 首屏同值——快开/检索/链接三面覆盖一致）。
/// snippet = body 中首条命中行 trim 后整行（⚠ D-20③：禁 .length 截断
/// ——CJK heap 串字节语义；CRLF 行尾 \r 剥离——is_delim 同族容错，
/// 行终止符非内容）；title-only 命中 = ""。装配 = json_esc + 逐项 `+`
/// 重接（links_json 同款）。
pub fn search_json(query str, limit int) str {
    var q str = query.trim()
    if q == "" {
        return "[]"
    }
    var n int = limit
    if n < 1 {
        n = 1
    }
    if n > 50 {
        n = 50
    }
    var ql str = q.to_lower()
    var pages List = collect_ad_pages("", 4)
    var out str = ""
    var hits int = 0
    var i int = 0
    while i < pages.len() {
        if hits < n {
            // ⚠ D-20②：列表元素先拷局部变量再取字段/调方法。
            var p = pages[i]
            var stem_l str = p.stem.to_lower()
            var body str = read_body(p.rel)
            var body_l str = body.to_lower()
            var is_hit bool = false
            if stem_l.contains(ql) {
                is_hit = true
            }
            if !is_hit {
                if body_l.contains(ql) {
                    is_hit = true
                }
            }
            if is_hit {
                // snippet = 首条命中行 trim 整行（跨多行命中只取首行；
                // title-only 命中 = ""）。
                var snip str = ""
                var lines = body.split("\n")
                var k int = 0
                while k < lines.len() {
                    if snip == "" {
                        var line str = lines[k]
                        line = line.replace("\r", "")
                        var line_l str = line.to_lower()
                        if line_l.contains(ql) {
                            snip = line.trim()
                        }
                    }
                    k = k + 1
                }
                if hits > 0 {
                    out = out + ","
                }
                out = out + "{\"path\":\"" + json_esc(p.rel) + "\",\"title\":\"" + json_esc(p.stem)
                out = out + "\",\"snippet\":\"" + json_esc(snip) + "\"}"
                hits = hits + 1
            }
        }
        i = i + 1
    }
    return "[" + out + "]"
}
