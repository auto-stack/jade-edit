// back/api.at — jade-edit 后端契约（PLAN-001 T-02；自有源，取代 PLAN-081
// 的 GENERATED 契约副本——contract-sync 漂移门随之退役，T-05）。
//
// 形态照 auto-edit PLAN-003 交付（013-todo 先例）：
//   vm merged（默认）      use back.api = 进程内 CALL 直调，无 HTTP；
//   vm split（--no-merge）front VM 经 HTTP 调本契约（AutoVM HTTP 服务，
//                          run_file 本文件 + 整模块 use 扁平化——具名导入
//                          不在扁平面，故契约内走 `use wsys` 整模块限定
//                          调用）；
//   vue 轨                ts_adapter 据此生成 HTTP client（vite 代理
//                          /api → AUTO_HTTP_PORT，`auto run --server vm`）。
//
// 路由前缀 /api；GET 带参走 query string。返回面全部标量（str/int/bool）
// ——规避 a2ts 已知缺口（List<T>/JsonAny/通配路由，PLAN-081 T-06 D-4）：
// tree 以 JSON 字符串交付，front 侧 json.to_value 解析（vue 转译吸收内建）。
//
// wiki 域语义（与 PLAN-081 旧契约的关键差异）：read_wiki 只回 **body**
// （frontmatter 在 back 侧保留/拼回，front 全程不触碰 JsonAny——T-03 两轮
// 实测的 VM JsonAny 损坏类自此结构性消除）；write_wiki(path, body) 由
// back 读盘现值、保 frontmatter 原文、拼新 body 落盘（旧「front 现读现传
// frontmatter」的绕法随边界内移而退役）。updated_at 补写属功能池后续批，
// v0 frontmatter 逐字保留。
//
// ⚠ pac 纪律：不写 api: 字段——服务引擎（AutoVM HTTP / a2r rust）留运行期
// --server 切换，默认 AutoVM + merged 直调（api:"rust" 会杀 merged）。
// 实现模块名 wsys（非 fs/ws）：与内建 fs 对象同名会在限定调用处遮蔽冲突
// （auto-edit T-03 实勘同款）。

use wsys

/// 工作区根（JADE_WORKSPACE 优先——fixture 隔离通道；AUTO_PROJECT_DIR
/// 兜底；缺席 "."。T-00 ③：automan.rs:1435 无条件覆盖 AUTO_PROJECT_DIR，
/// 故隔离 env 必须独立命名）
/// GET /api/ws_root
#[api(method = "GET", path = "/api/ws_root")]
pub fn ws_root() str {
    return wsys.root_dir()
}

/// 目录树（JSON 字符串，depth 层；节点 schema {id,label,children,kind,
/// icon,is_leaf,badge}，id=相对路径——bps flatten_tree 直吃）
/// GET /api/tree?path=..&depth=..
#[api(method = "GET", path = "/api/tree")]
pub fn tree(path str, depth int) str {
    return wsys.tree_json(path, depth)
}

/// 读 wiki 文档 body（frontmatter 剥离；无 frontmatter 文件直通全文）
/// GET /api/read_wiki?path=..
#[api(method = "GET", path = "/api/read_wiki")]
pub fn read_wiki(path str) str {
    return wsys.read_body(path)
}

/// 写 wiki 文档（back 侧保留磁盘 frontmatter 原文 + 拼入新 body；无
/// frontmatter 文件 = 新建直写 body）
/// POST /api/write_wiki
#[api(method = "POST", path = "/api/write_wiki")]
pub fn write_wiki(path str, body str) bool {
    return wsys.write_body(path, body)
}

/// 路径存在性（目录节点不命中 → 静默忽略语义）
/// GET /api/exists?path=..
#[api(method = "GET", path = "/api/exists")]
pub fn exists(path str) bool {
    return wsys.path_exists(path)
}

/// 环境变量读（未设 = ""；AUTO_OPEN_PATH/AUTO_SAVE_PATH 测试旁路通道）
/// GET /api/env_str?name=..
#[api(method = "GET", path = "/api/env_str")]
pub fn env_str(name str) str {
    return wsys.env_lookup(name)
}
