// back/api.at — jade-edit 后端契约（PLAN-001 T-02；自有源，取代 PLAN-081
// 的 GENERATED 契约副本——contract-sync 漂移门随之退役，T-05）。
//
// 形态照 auto-edit PLAN-003 交付（013-todo 先例）：
//   vm merged（默认）      use back.api = 进程内 CALL 直调，无 HTTP；
//   vm split（--no-merge）front VM 经 HTTP 调本契约（AutoVM HTTP 服务，
//                          run_file 本文件 + 整模块 use 扁平化——具名导入
//                          不在扁平面，故契约内走 `use wsys` 整模块限定
//                          调用）；
//   vue 轨                ts_adapter 据此生成 HTTP client（vite 代理
//                          /api → AUTO_HTTP_PORT，`auto run --server vm`）。
//
// 路由前缀 /api；GET 带参走 query string。返回面全部标量（str/int/bool）
// ——规避 a2ts 已知缺口（List<T>/JsonAny/通配路由，PLAN-081 T-06 D-4）：
// tree 以 JSON 字符串交付，front 侧 json.to_value 解析（vue 转译吸收内建）。
//
// wiki 域语义（与 PLAN-081 旧契约的关键差异）：read_wiki 只回 **body**
// （frontmatter 在 back 侧保留/拼回，front 全程不触碰 JsonAny——T-03 两轮
// 实测的 VM JsonAny 损坏类自此结构性消除）；write_wiki(path, body) 由
// back 读盘现值、保 frontmatter 原文、拼新 body 落盘（旧「front 现读现传
// frontmatter」的绕法随边界内移而退役）。updated_at 补写属功能池后续批，
// v0 frontmatter 逐字保留。
//
// ⚠ pac 纪律：不写 api: 字段——服务引擎（AutoVM HTTP / a2r rust）留运行期
// --server 切换，默认 AutoVM + merged 直调（api:"rust" 会杀 merged）。
// 实现模块名 wsys（非 fs/ws）：与内建 fs 对象同名会在限定调用处遮蔽冲突
// （auto-edit T-03 实勘同款）。

use wsys

/// 工作区根（JADE_WORKSPACE 优先——fixture 隔离通道；AUTO_PROJECT_DIR
/// 兜底；缺席 "."。T-00 ③：automan.rs:1435 无条件覆盖 AUTO_PROJECT_DIR，
/// 故隔离 env 必须独立命名）
/// GET /api/ws_root
#[api(method = "GET", path = "/api/ws_root")]
pub fn ws_root() str {
    return wsys.root_dir()
}

/// 目录树（JSON 字符串，depth 层；节点 schema {id,label,children,kind,
/// icon,is_leaf,badge}，id=相对路径——bps flatten_tree 直吃）
/// GET /api/tree?path=..&depth=..
#[api(method = "GET", path = "/api/tree")]
pub fn tree(path str, depth int) str {
    return wsys.tree_json(path, depth)
}

/// 读 wiki 文档 body（frontmatter 剥离；无 frontmatter 文件直通全文）
/// GET /api/read_wiki?path=..
#[api(method = "GET", path = "/api/read_wiki")]
pub fn read_wiki(path str) str {
    return wsys.read_body(path)
}

/// 写 wiki 文档（back 侧保留磁盘 frontmatter 原文 + 拼入新 body；无
/// frontmatter 文件 = 新建直写 body）
/// POST /api/write_wiki
#[api(method = "POST", path = "/api/write_wiki")]
pub fn write_wiki(path str, body str) bool {
    return wsys.write_body(path, body)
}

/// 路径存在性（目录节点不命中 → 静默忽略语义）
/// GET /api/exists?path=..
#[api(method = "GET", path = "/api/exists")]
pub fn exists(path str) bool {
    return wsys.path_exists(path)
}

/// 环境变量读（未设 = ""；AUTO_OPEN_PATH/AUTO_SAVE_PATH 测试旁路通道）
/// GET /api/env_str?name=..
#[api(method = "GET", path = "/api/env_str")]
pub fn env_str(name str) str {
    return wsys.env_lookup(name)
}

/// 工作区链接索引（JSON 字符串；fs.tree 同源遍历收 .ad（覆盖=文件树、
/// 确定性序）：stem 解析 + [[Target]]/[[Target#anchor]] 提取 + exists
/// 判定——PLAN-003 知识库首切片。标量 JSON 纪律同 tree：C-1/D-04，
/// front 侧 json.to_value 解析）
/// GET /api/link_index?path=..&depth=..
#[api(method = "GET", path = "/api/link_index")]
pub fn link_index(path str, depth int) str {
    return wsys.links_json(path, depth)
}

/// 工作区全文检索（JSON 字符串；stem+body 线性扫描，命中=
/// [{path,title,snippet}]——PLAN-004 知识库第二切片。标量 JSON 纪律同
/// link_index：顶层裸数组，front 侧 json.to_value 解析）。
/// **POST 而非 GET**：D-19（AutoVM HTTP 对 GET query 的 UTF-8 百分号
/// 序列不解码——CJK 查询词在 split/vue 臂全败）；POST body CJK 已证
///（write_wiki 同款）。匹配语义见 wsys.search_json（SD-401 定文）。
/// POST /api/search_wiki
#[api(method = "POST", path = "/api/search_wiki")]
pub fn search_wiki(query str, limit int) str {
    return wsys.search_json(query, limit)
}

/// 悬空建页（PLAN-005 第三切片；wikilink 写闭环收口）：title 清洗 →
/// 工作区根落位 {safe}.ad。已存在 = **幂等不写**返回现路径（守卫 back
/// 侧内移——front exists 预检对 CJK 在 split/vue 臂失效[D-19]，且
/// 「先 exists 后 write」两跳有竞态；write_body 对存在档会改写 body，
/// 绝不复用作建页通道）；成功返回工作区根相对 path；"" = 空名守卫/
/// 落盘复核失败。模板 = "# {title}\n\n"（title = wikilink 原文非清洗名
/// ——显示保真；无 frontmatter——D-14 逐字保留哲学）。清洗规则见
/// wsys.title_to_path（SD-501 定文）。
/// **POST 而非 GET**（D-19 同 search_wiki：悬空目标多为 CJK，GET query
/// 不解码；POST body CJK 已证）。
/// POST /api/create_page
#[api(method = "POST", path = "/api/create_page")]
pub fn create_page(title str) str {
    return wsys.create_page_impl(title)
}

/// 页面删除（PLAN-007 第五切片；工作区运维收口）：**入链悬空化，不改
/// 写源文**——与 rename_page 反链改写成语义对照并表（SD-701）：改名保
/// 完整性，删除如实悬空（出链行 exists 翻转可见；悬空行可再建页接回
/// ——create_page 幂等弧线闭合）。卫语句序：.ad 后缀卫先于 exists
///（目录名/裸名/其他扩展一律拒——既有路径同样拒，防目录误删）+ exists
/// 缺失拒 + **删后 exists 双复核**（D-24②：File.delete 恒返 0 吞错，
/// 删除成功唯一可信判据 = 删后存在性翻转）。成功返回工作区根相对
/// path；"" = 非 .ad/缺失/删除未生效。
/// **POST 而非 GET**（D-19 同 create_page/rename_page：path CJK 常态，
/// body 传参）。
/// POST /api/delete_page
#[api(method = "POST", path = "/api/delete_page")]
pub fn delete_page(path str) str {
    return wsys.delete_page_impl(path)
}

/// 页面重命名 + 反链源文改写（PLAN-006 第四切片；知识完整性件——jade
/// 链接面纯派生无索引可补丁，源文改写是唯一一致口径，Obsidian「更新链
/// 接」同形态）：同目录 stem 变更；全部 [[Old]]/[[Old#anchor]] 精确
/// stem 匹配改写（anchor 保留；含被改名档自链；frontmatter 经 write_body
/// 保留；转义 `\[\[` 字面量不涉）。成功返回工作区根相对新 path；"" =
/// 任一卫语句拒（old 缺失/清洗空名/目标冲突/**case-only**——G3 裁决：
/// stem 匹配维持精确比较，case-only 重命名拒）。**POST 而非 GET**（D-19
/// ：old_path/new_name 均 body 传参——old_path 工作区相对 CJK 常态）。
/// POST 单事务五步流程见 wsys.rename_page_impl（SD-601 定文）。
/// POST /api/rename_page
#[api(method = "POST", path = "/api/rename_page")]
pub fn rename_page(old_path str, new_name str) str {
    return wsys.rename_page_impl(old_path, new_name)
}

/// 工作区标签索引（PLAN-008 第六切片；frontmatter 消费面**只读首开**
/// ——D-14 写面不动）：字符串层解析 tags: block-list（缩进两形态
/// trim 归一；inline 数组形态贡献零不炸——§10.1）→ 聚合
/// [{tag, paths:[相对路径]}]（**顶层裸数组**——link_index 同裁定；
/// tag 序 = walk 序 first-seen 确定性）。语义定文见 wsys.tags_json
/// （SD-801）。
/// **GET 通道**（tree/link_index 同族：path/depth 工作区级 ASCII 常态
/// ——tag 值在响应 body，UTF-8 JSON 无 D-19 面）。
/// GET /api/tags_index?path=..&depth=..
#[api(method = "GET", path = "/api/tags_index")]
pub fn tags_index(path str, depth int) str {
    return wsys.tags_json(path, depth)
}

/// 提及转链接（PLAN-010 第八切片；链接域二期写面补全）：path 档 body
/// 明区（[[..]] 标记外）stem 纯文本出现处改写为 [[stem]]（frontmatter
/// 保留）；返回改写处数（"0"=无，""=卫语句拒）。
/// **POST 而非 GET**（D-19：path/stem CJK 常态，body 传参）。
/// POST /api/linkify_page
#[api(method = "POST", path = "/api/linkify_page")]
pub fn linkify_page(path str, stem str) str {
    return wsys.linkify_page_impl(path, stem)
}

/// 页面元数据读（PLAN-011 第九切片；D-14 受控写面读半）：path 档
/// frontmatter 的 tags/aliases 两键读出——裸数组 [{key,value}]（D-20④
/// 顶层数组唯一健康形状；缺席键项不装配），value = 逗号连接串。
/// GET 通道（path CJK 面 = D-19 同款口径：split 臂 CJK 路径降级空态，
/// merged/进程内全量可用——v1 记账 §10）。
/// GET /api/page_meta?path=..
#[api(method = "GET", path = "/api/page_meta")]
pub fn page_meta(path str) str {
    return wsys.page_meta_json(path)
}

/// 页面元数据受控写（PLAN-011；**D-14 受控裁决落地**——仅 tags/aliases
/// 两键改写、其余键逐字节保留、空值删键、无 frontmatter 档增建界符段、
/// 值归一无缩进 block-list、CRLF 行尾风格继承、同值重写逐字节幂等）；
/// 返回 "ok"（成功/幂等 no-op）或 ""（卫语句拒）。
/// **POST 而非 GET**（D-19：path/值 CJK 常态，body 传参）。
/// POST /api/set_page_meta
#[api(method = "POST", path = "/api/set_page_meta")]
pub fn set_page_meta(path str, tags str, aliases str) str {
    return wsys.set_page_meta_impl(path, tags, aliases)
}

/// 新建目录（PLAN-012 第十切片；工作区组织二期）：清洗复用 title_to_path
/// 去 .ad 段（九字符→'-'——弹层输入不可能含 "/"，嵌套名结构性不出现）→
/// 工作区根落位（根落位口径同 create_page）；**幂等**（已存在目录 → 返回
/// 现路径零变化）+ 双复核（File.is_dir 翻转——探针 B 定谳可调；同名文件
/// 边案：create_dir 静默失败 → is_dir 不翻转 → ""）。成功返回工作区根
/// 相对目录路径；"" = 空名守卫/同名文件/创建未生效。
/// **POST 而非 GET**（D-19：目录名 CJK 常态，body 传参）。
/// POST /api/create_dir
#[api(method = "POST", path = "/api/create_dir")]
pub fn create_dir(name str) str {
    return wsys.create_dir_impl(name)
}

/// 移动档到目标目录（PLAN-012；**stem 不变 ⇒ 链接零改写零断链**——与
/// rename_page（stem 变⇒改写入链）/delete_page（档消⇒入链悬空）构成
/// 三联语义对照，SD-1201 并表）：POST 单事务五步（卫：源 exists + 目标
/// is_dir[探针 B 定谳]/同路径幂等返回原 path/目标处同名冲突拒/read_text
/// +write_text+delete 组合迁移[006 定文形态]+双复核）。成功返回工作区根
/// 相对新 path；"" = 任一卫语句拒/迁移未生效。**不涉链接改写**（结构性
/// 不需要——链接面纯 stem 解析，目录无感）。
/// **POST 而非 GET**（D-19：path/dir CJK 常态，body 传参）。
/// POST /api/move_page
#[api(method = "POST", path = "/api/move_page")]
pub fn move_page(path str, dir str) str {
    return wsys.move_page_impl(path, dir)
}


