// pac.at — auto-jade（PLAN-081 单工程双轨首例）。
//
// T-00 R-1 裁定 A'（docs/plans/081-t00-rulings.md）：
//   render: ["vm","vue"] 单声明 + 双命令分工——
//     vm 轨：  auto run -r vm   （运行期渲染覆盖，iced 原生窗）
//     vue 轨：auto build -r vue（build 期覆盖，生成 Vue3+Vite 工程）
//   ⚠ 禁止裸 `auto build`：Multi 声明下选 vm 项走 C/ninja 转译路径。
name: "auto-jade"
version: "0.1.0"
description: "auto-jade — AutoDown 编辑器（单工程双轨：vm 解释渲染 + vue 生成）"
scene: "ui"
render: ["vm","vue"]
title: "AutoJade"
title_zh: "玉简编辑"
window: "1100x750"
front_port: 4181

// PLAN-081 §10 默认裁定 #3：stylekit 跨仓相对路径 dep（auto-edit 家族栈
// 形态；主检出目录 jade-edit（磁盘名不改，PLAN-040 D-1）与
// auto-edit/auto-lang/auto-down 同居 D:/autostack）。
dep stylekit {
    path: "../auto-edit/specs/stylekit"
}

// bps 蓝图池（filetree：tree_util/tree_icon；L1 零副本，PLAN-002 同族形态）。
dep bps {
    path: "../auto-lang/blueprints"
}

// auto-os/PLAN-061 T-03：官方主题包正式接入——`vendor/themes` 为 UI 管理渠道
// 发布的**固定版本快照**（themes 0.2.0，内容 digest
// 9fa07742dc68aa5377ae06cb2d966386002063f184c515b6c5dddf8a6bef838e，
// per-file sha256 与源包逐文件校验同律；不可二次编辑、非第二权威源）。
// theme 键保持缺省 = follow 宿主；未存稿/草稿保护/编辑引擎为业务面不随肤
// 重染。主合同反链见 README。
dep themes {
    path: "vendor/themes"
}

// vue 轨 engine 消费（@autodown/engine 外部官方组件；出口契约 1.0 冻结）。
// ⚠ link 路径基准 = 生成工程包位置（gen/front/vue），非本 pac 位置——
// 生成器原样并入 gen package.json（T-06 实证：基准错=断链 symlink）。
npm_deps: {
    "@autodown/engine": "link:../../../../auto-down/autodown/packages/engine"
}
